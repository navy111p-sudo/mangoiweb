        "ko": "디노",
        "en": "Dino"
      }
    },
    "mina": {
      "name": {
        "ko": "미나",
        "en": "Mina"
      }
    },
    "leo": {
      "name": {
        "ko": "레오",
        "en": "Leo"
      }
    },
    "robo": {
      "name": {
