      },
      "lines": [
        {
          "id": "s1-l1",
          "speaker": "kai",
          "en": "Pip, you came back again!",
          "ko": "핍, 네가 다시 놀러 왔구나!",
          "emotion": "relieved",
          "scored": true,
          "start": 0.8389791666666667,
          "end": 2.693979166666667
        },
        {
          "id": "s1-l2",
          "speaker": "emma",
          "en": "Look! A ship needs help!",
          "ko": "봐! 배가 도움을 요청해!",
          "emotion": "alert",
          "scored": true,
          "start": 6.549625,
          "end": 10.654625
        },
        {
          "id": "s1-l3",
          "speaker": "maya",
          "en": "That flag has a robot!",
          "ko": "저 깃발에 로봇이 있어!",
          "emotion": "curious",
          "scored": true,
          "start": 11.393604166666666,
          "end": 13.558604166666667
        },
        {
          "id": "s1-l4",
          "speaker": "pip",
          "en": "My signal comes from there.",
          "ko": "내 신호가 저기서 와.",
          "emotion": "focused",
          "scored": true,
          "start": 14.9874375,
          "end": 17.4374375
        },
        {
          "id": "s1-l5",
          "speaker": "momo",
          "en": "Welcome aboard, my brave friends!",
          "ko": "용감한 친구들, 승선을 환영해!",
          "emotion": "welcoming",
          "scored": true,
          "start": 18.726416666666665,
          "end": 22.341416666666667
        },
        {
          "id": "s1-l6",
          "speaker": "kai",
          "en": "Where is that robot going?",
          "ko": "저 로봇은 어디로 가?",
          "emotion": "curious",
          "scored": true,
          "start": 24.15525,
          "end": 25.810270833333334
        },
        {
          "id": "s1-l7",
          "speaker": "emma",
          "en": "His screen shows a worried face.",
          "ko": "화면에 걱정스러운 얼굴이 보여.",
          "emotion": "concerned",
          "scored": true,
          "start": 26.894229166666666,
          "end": 29.279229166666667
        },
        {
          "id": "s1-l8",
          "speaker": "maya",
          "en": "Let us follow him together.",
          "ko": "우리 함께 따라가 보자.",
          "emotion": "determined",
          "scored": true,
          "start": 30.018208333333334,
          "end": 31.813208333333332
        },
        {
          "id": "s1-l9",
          "speaker": "pip",
          "en": "I can hear something ringing.",
          "ko": "뭔가 울리는 소리가 들려.",
          "emotion": "curious",
          "scored": true,
          "start": 33.447041666666664,
          "end": 35.4170625
        },
        {
          "id": "s1-l10",
          "speaker": "momo",
          "en": "Please keep that chest safe.",
          "ko": "저 상자를 안전하게 지켜 줘.",
          "emotion": "earnest",
          "scored": true,
          "start": 36.18602083333333,
          "end": 38.27102083333333
        }
      ],
      "poster": "/media/dubbing/dub-004/scene-1.jpg"
    },
