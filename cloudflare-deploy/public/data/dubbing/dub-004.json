      "lines": [
        {
          "id": "s4-l1",
          "speaker": "maya",
          "en": "Please show us your treasure.",
          "ko": "보물을 우리에게 보여 줘.",
          "emotion": "curious",
          "scored": true,
          "start": 0.86425,
          "end": 3.17925
        },
        {
          "id": "s4-l2",
          "speaker": "momo",
          "en": "It is the lighthouse heart.",
          "ko": "등대의 심장이란다.",
          "emotion": "warm",
          "scored": true,
          "start": 4.6285,
          "end": 6.5485
        },
        {
          "id": "s4-l3",
          "speaker": "emma",
          "en": "A light, not gold coins!",
          "ko": "금화가 아니라 빛이었어!",
          "emotion": "amazed",
          "scored": true,
          "start": 7.39275,
          "end": 10.80775
        },
        {
          "id": "s4-l4",
          "speaker": "kai",
          "en": "You were rescuing the lost sailors!",
          "ko": "길 잃은 선원들을 구하고 있었구나!",
          "emotion": "realizing",
          "scored": true,
          "start": 12.886541666666666,
          "end": 14.841541666666666
        },
        {
          "id": "s4-l5",
          "speaker": "pip",
          "en": "This crystal uses star energy.",
          "ko": "이 수정은 별 에너지를 써.",
          "emotion": "recognizing",
          "scored": true,
          "start": 15.650791666666667,
          "end": 18.355791666666665
        },
        {
          "id": "s4-l6",
          "speaker": "maya",
          "en": "That is why you called us!",
          "ko": "그래서 우리를 부른 거구나!",
          "emotion": "realizing",
          "scored": true,
          "start": 20.144583333333333,
          "end": 22.2264375
        },
        {
          "id": "s4-l7",
          "speaker": "momo",
          "en": "Yes! Their boats need this light.",
          "ko": "그래! 배들에게 이 빛이 필요해.",
          "emotion": "earnest",
          "scored": true,
          "start": 23.908833333333334,
          "end": 27.183854166666666
        },
        {
          "id": "s4-l8",
          "speaker": "emma",
          "en": "Sorry we judged your pirate flag.",
          "ko": "해적 깃발만 보고 판단해서 미안해.",
          "emotion": "apologetic",
          "scored": true,
          "start": 27.948104166666667,
          "end": 30.733125
        },
        {
          "id": "s4-l9",
          "speaker": "kai",
          "en": "Let us bring everyone home.",
          "ko": "모두 집으로 돌아오게 하자.",
          "emotion": "determined",
          "scored": true,
          "start": 32.441895833333334,
          "end": 34.03189583333333
        },
        {
          "id": "s4-l10",
          "speaker": "pip",
          "en": "I can help it shine again.",
          "ko": "내가 다시 빛나게 도울 수 있어.",
          "emotion": "hopeful",
          "scored": true,
          "start": 35.20614583333333,
          "end": 37.58614583333333
        }
      ],
