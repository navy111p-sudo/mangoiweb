      },
      "lines": [
        {
          "id": "s2-l1",
          "speaker": "emma",
          "en": "Why is the chest glowing?",
          "ko": "왜 상자가 빛나는 거지?",
          "emotion": "curious",
          "scored": true,
          "start": 1.1321041666666667,
          "end": 2.8171458333333335
        },
        {
          "id": "s2-l2",
          "speaker": "momo",
          "en": "It holds something very precious.",
          "ko": "아주 소중한 것이 들어 있어.",
          "emotion": "gentle",
          "scored": true,
          "start": 4.164208333333334,
          "end": 6.704208333333334
        },
        {
          "id": "s2-l3",
          "speaker": "kai",
          "en": "Did you take that treasure?",
          "ko": "저 보물을 가져온 거야?",
          "emotion": "uncertain",
          "scored": true,
          "start": 8.1963125,
          "end": 9.7313125
        },
        {
          "id": "s2-l4",
          "speaker": "pip",
          "en": "Wait! Let us ask first.",
          "ko": "잠깐! 먼저 물어보자.",
          "emotion": "calm",
          "scored": true,
          "start": 12.378854166666667,
          "end": 15.078854166666666
        },
        {
          "id": "s2-l5",
          "speaker": "maya",
          "en": "Momo is pointing toward the shore.",
          "ko": "모모가 해안을 가리키고 있어.",
          "emotion": "observant",
          "scored": true,
          "start": 16.410958333333333,
          "end": 19.270958333333333
        },
        {
          "id": "s2-l6",
          "speaker": "emma",
          "en": "There is a dark lighthouse!",
          "ko": "불 꺼진 등대가 있어!",
          "emotion": "surprised",
          "scored": true,
          "start": 21.4535,
          "end": 23.1935
        },
        {
          "id": "s2-l7",
          "speaker": "momo",
          "en": "We must reach it before sunset.",
          "ko": "해 지기 전에 도착해야 해.",
          "emotion": "urgent",
          "scored": true,
          "start": 24.225604166666667,
          "end": 26.205604166666667
        },
        {
          "id": "s2-l8",
          "speaker": "kai",
          "en": "I think I misunderstood you.",
          "ko": "내가 모모를 오해한 것 같아.",
          "emotion": "thoughtful",
          "scored": true,
          "start": 27.237708333333334,
          "end": 29.187708333333333
        },
        {
          "id": "s2-l9",
          "speaker": "pip",
          "en": "The light is getting weaker.",
          "ko": "빛이 점점 약해지고 있어.",
          "emotion": "concerned",
          "scored": true,
          "start": 31.42025,
          "end": 33.48525
        },
        {
          "id": "s2-l10",
          "speaker": "maya",
          "en": "Then we must work together.",
          "ko": "그럼 우리가 힘을 합쳐야 해.",
          "emotion": "determined",
          "scored": true,
          "start": 34.517354166666664,
          "end": 37.017354166666664
        }
      ],
      "poster": "/media/dubbing/dub-004/scene-2.jpg"
    },
