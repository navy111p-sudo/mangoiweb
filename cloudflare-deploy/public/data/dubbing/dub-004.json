      "lines": [
        {
          "id": "s3-l1",
          "speaker": "momo",
          "en": "Hold tight! The wind is changing!",
          "ko": "꽉 잡아! 바람이 바뀌고 있어!",
          "emotion": "alert",
          "scored": true,
          "start": 0.6449791666666667,
          "end": 3.6099791666666667
        },
        {
          "id": "s3-l2",
          "speaker": "kai",
          "en": "I can hold this rope.",
          "ko": "내가 이 밧줄을 잡을게.",
          "emotion": "determined",
          "scored": true,
          "start": 4.189958333333333,
          "end": 5.539958333333334
        },
        {
          "id": "s3-l3",
          "speaker": "emma",
          "en": "I will check the map.",
          "ko": "내가 지도를 확인할게.",
          "emotion": "focused",
          "scored": true,
          "start": 6.7349375,
          "end": 8.2449375
        },
        {
          "id": "s3-l4",
          "speaker": "maya",
          "en": "Pip, help me secure the chest.",
          "ko": "핍, 상자 고정하는 걸 도와줘.",
          "emotion": "focused",
          "scored": true,
          "start": 9.664916666666667,
          "end": 14.324916666666667
        },
        {
          "id": "s3-l5",
          "speaker": "pip",
          "en": "Together! One, two, three, pull!",
          "ko": "함께! 하나, 둘, 셋, 당겨!",
          "emotion": "energetic",
          "scored": true,
          "start": 15.209895833333333,
          "end": 20.038020833333334
        },
        {
          "id": "s3-l6",
          "speaker": "momo",
          "en": "Great teamwork! Keep your feet steady.",
          "ko": "멋진 협동이야! 발을 단단히 디뎌.",
          "emotion": "encouraging",
          "scored": true,
          "start": 21.139875,
          "end": 23.874875
        },
        {
          "id": "s3-l7",
          "speaker": "kai",
          "en": "Momo just caught my hat!",
          "ko": "모모가 내 모자를 잡았어!",
          "emotion": "delighted",
          "scored": true,
          "start": 24.419854166666667,
          "end": 27.854854166666666
        },
        {
          "id": "s3-l8",
          "speaker": "emma",
          "en": "The safe path is this way.",
          "ko": "안전한 길은 이쪽이야.",
          "emotion": "confident",
          "scored": true,
          "start": 28.399833333333333,
          "end": 30.419833333333333
        },
        {
          "id": "s3-l9",
          "speaker": "maya",
          "en": "The chest is safe now.",
          "ko": "이제 상자는 안전해.",
          "emotion": "relieved",
          "scored": true,
          "start": 31.3498125,
          "end": 33.7148125
        },
        {
          "id": "s3-l10",
          "speaker": "pip",
          "en": "Look! The clouds are opening!",
          "ko": "봐! 구름이 걷히고 있어!",
          "emotion": "hopeful",
          "scored": true,
          "start": 34.259791666666665,
          "end": 38.7698125
        }
      ],
      "poster": "/media/dubbing/dub-004/scene-3.jpg"
    },
