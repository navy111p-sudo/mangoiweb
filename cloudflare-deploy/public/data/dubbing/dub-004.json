        {
          "id": "s5-l1",
          "speaker": "pip",
          "en": "Place the crystal right here.",
          "ko": "수정을 바로 여기에 놓아 줘.",
          "emotion": "focused",
          "scored": true,
          "start": 0.7265625,
          "end": 2.6565625
        },
        {
          "id": "s5-l2",
