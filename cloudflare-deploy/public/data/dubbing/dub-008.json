      "lines": [
        {
          "id": "s1-shot1-l1",
          "speaker": "ollie",
          "en": "Today is the Rainbow Festival!",
          "ko": "오늘은 무지개 축제야!",
          "start": 1.42,
          "end": 3.967479
        },
        {
          "id": "s1-shot1-l2",
          "speaker": "blue",
          "en": "Look at the flags!",
          "ko": "깃발들을 봐!",
          "start": 6.422,
          "end": 8.148542
        },
        {
          "id": "s1-shot1-l3",
          "speaker": "puffy",
          "en": "They are so pretty!",
          "ko": "정말 예쁘다!",
          "start": 12.62,
          "end": 14.322354
        },
        {
          "id": "s1-shot2-l1",
          "speaker": "blue",
          "en": "A little higher, please.",
          "ko": "조금만 더 높이 올려 줘.",
          "start": 15.763333,
          "end": 17.463896
        },
        {
          "id": "s1-shot2-l2",
          "speaker": "puffy",
          "en": "Like this?",
          "ko": "이렇게?",
          "start": 22.179833,
          "end": 23.173729
        },
        {
          "id": "s1-shot2-l3",
          "speaker": "blue",
          "en": "Yes! Thank you!",
          "ko": "응! 고마워!",
          "start": 23.253729,
          "end": 25.44925
        },
        {
          "id": "s1-shot2-l4",
          "speaker": "ollie",
          "en": "Great job!",
          "ko": "정말 잘했어!",
          "start": 26.473333,
          "end": 28.493396
        },
        {
          "id": "s1-shot3-l1",
          "speaker": "bubbles",
          "en": "I have cookies!",
          "ko": "나 쿠키 있어!",
          "start": 29.786667,
          "end": 31.095313
        },
        {
          "id": "s1-shot3-l2",
          "speaker": "mini",
          "en": "Can I have one?",
          "ko": "하나 먹어도 돼?",
          "start": 37.206667,
          "end": 38.269083
        },
        {
          "id": "s1-shot3-l3",
          "speaker": "bubbles",
          "en": "Yes! Let us share.",
          "ko": "응! 함께 나눠 먹자.",
          "start": 38.646667,
          "end": 41.253333
        },
        {
          "id": "s1-shot3-l4",
          "speaker": "mini",
          "en": "Thank you!",
          "ko": "고마워!",
          "start": 42.396667,
          "end": 43.272833
        },
        {
          "id": "s1-shot4-l1",
          "speaker": "mini",
          "en": "Look! A butterfly!",
          "ko": "봐! 나비야!",
          "start": 46.11,
          "end": 47.688125
        },
        {
          "id": "s1-shot4-l2",
          "speaker": "bubbles",
          "en": "On my nose?",
          "ko": "내 코 위에?",
          "start": 50.71,
          "end": 51.785708
        },
        {
          "id": "s1-shot4-l3",
          "speaker": "bubbles",
          "en": "Excuse me!",
          "ko": "실례합니다!",
          "start": 56.5,
          "end": 57.610958
        },
        {
          "id": "s1-shot4-l4",
          "speaker": "mini",
          "en": "Bless you!",
          "ko": "건강하렴!",
          "start": 58.37,
          "end": 59.199125
        },
        {
          "id": "s1-shot5-l1",
          "speaker": "green",
          "en": "This is our rainbow light.",
          "ko": "이건 우리의 무지개 등불이야.",
          "start": 62.619333,
          "end": 64.626708
        },
        {
          "id": "s1-shot5-l2",
          "speaker": "blue",
          "en": "Tonight, it will shine.",
          "ko": "오늘 밤에 빛날 거야.",
          "start": 66.373333,
          "end": 69.119458
        },
        {
          "id": "s1-shot5-l3",
          "speaker": "green",
          "en": "Look at the colors!",
          "ko": "색깔들을 봐!",
          "start": 70.453333,
          "end": 71.558896
        },
        {
          "id": "s1-shot6-l1",
          "speaker": "mini",
          "en": "Red, yellow, green, and blue!",
          "ko": "빨강, 노랑, 초록, 파랑!",
          "start": 76.326667,
          "end": 79.733208
        },
        {
          "id": "s1-shot6-l2",
          "speaker": "puffy",
          "en": "So many colors!",
          "ko": "색이 정말 많아!",
          "start": 81.046667,
          "end": 82.510813
        },
        {
          "id": "s1-shot6-l3",
          "speaker": "green",
          "en": "Rainbow sparkles!",
          "ko": "반짝이는 무지개야!",
          "start": 84.246667,
          "end": 86.024771
        },
        {
          "id": "s1-shot6-l4",
          "speaker": "mini",
          "en": "Beautiful!",
          "ko": "아름다워!",
          "start": 87.046667,
          "end": 87.629938
        },
        {
          "id": "s1-shot7-l1",
          "speaker": "mini",
          "en": "Can we put it up there?",
          "ko": "저 위에 올려도 돼?",
          "start": 93.36,
          "end": 94.767042
        },
        {
          "id": "s1-shot7-l2",
          "speaker": "puffy",
          "en": "Later. We will do it together.",
          "ko": "나중에. 우리 함께 하자.",
          "start": 96.7465,
          "end": 99.299958
        },
        {
          "id": "s1-shot7-l3",
          "speaker": "mini",
          "en": "Okay. Together.",
          "ko": "좋아. 함께 하자.",
          "start": 99.39,
          "end": 102.256271
        },
        {
          "id": "s1-shot8-l1",
          "speaker": "blue",
          "en": "Oh! The ribbon!",
          "ko": "어! 리본이!",
          "start": 107.413333,
          "end": 109.483687
        },
        {
          "id": "s1-shot8-l2",
          "speaker": "ollie",
          "en": "I can get it!",
          "ko": "내가 잡을 수 있어!",
          "start": 112.313333,
          "end": 113.946042
        },
        {
          "id": "s1-shot8-l3",
          "speaker": "blue",
          "en": "Be careful!",
          "ko": "조심해!",
          "start": 116.035333,
          "end": 117.161708
        },
        {
          "id": "s1-shot8-l4",
          "speaker": "ollie",
          "en": "I got it!",
          "ko": "잡았다!",
          "start": 117.241708,
          "end": 118.658771
        }
      ]
    },
    {
      "no": 2,
      "label": {
        "ko": "반짝이는 단서",
        "en": "Sparkling Clues"
      },
      "arc": "seung",
      "durationSec": 175.83333333333334,
      "video": "/media/dubbing/dub-008/scene-2.mp4",
      "poster": "/media/dubbing/dub-008/scene-2.jpg",
      "videoAudio": "mute",
      "bgm": "/media/dubbing/dub-008/scene-2-bgm.mp3",
      "sfx": [],
      "voices": {
        "ollie": "/media/dubbing/dub-008/scene-2-ollie.mp3",
        "blue": "/media/dubbing/dub-008/scene-2-blue.mp3",
        "puffy": "/media/dubbing/dub-008/scene-2-puffy.mp3",
        "mini": "/media/dubbing/dub-008/scene-2-mini.mp3",
        "green": "/media/dubbing/dub-008/scene-2-green.mp3",
        "bubbles": "/media/dubbing/dub-008/scene-2-bubbles.mp3"
      },
      "lines": [
        {
          "id": "s2-shot9-l1",
          "speaker": "green",
          "en": "Wait. Where is the light?",
          "ko": "잠깐. 등불이 어디 있지?",
          "start": 5.596667,
          "end": 8.087313
        },
        {
          "id": "s2-shot9-l2",
          "speaker": "puffy",
          "en": "It is gone!",
          "ko": "사라졌어!",
          "start": 9.416667,
          "end": 10.644646
        },
        {
          "id": "s2-shot9-l3",
          "speaker": "mini",
          "en": "Oh, no.",
          "ko": "이런.",
          "start": 13.496667,
          "end": 14.464521
        },
        {
          "id": "s2-shot10-l1",
          "speaker": "ollie",
          "en": "Was it here?",
          "ko": "여기 있었어?",
          "start": 16.498,
          "end": 18.116083
        },
        {
          "id": "s2-shot10-l2",
          "speaker": "green",
          "en": "Yes. Right here.",
          "ko": "응. 바로 여기.",
          "start": 20.2725,
          "end": 21.968354
        },
        {
          "id": "s2-shot10-l3",
          "speaker": "ollie",
          "en": "Where is the light?",
          "ko": "등불이 어디 있지?",
          "start": 23.4245,
          "end": 25.76575
        },
        {
          "id": "s2-shot10-l4",
          "speaker": "green",
          "en": "Let us look.",
          "ko": "찾아보자.",
          "start": 27.8405,
          "end": 28.53375
        },
        {
          "id": "s2-shot11-l1",
          "speaker": "blue",
          "en": "Is it under the table?",
          "ko": "탁자 아래에 있니?",
          "start": 32.543333,
          "end": 34.283521
        },
        {
          "id": "s2-shot11-l2",
          "speaker": "green",
          "en": "No. It is not here.",
          "ko": "아니. 여기에는 없어.",
          "start": 34.863333,
          "end": 37.023521
        },
        {
          "id": "s2-shot11-l3",
          "speaker": "blue",
          "en": "Oops!",
          "ko": "이런!",
          "start": 39.123333,
          "end": 39.845271
        },
        {
          "id": "s2-shot11-l4",
          "speaker": "green",
          "en": "Are you okay?",
          "ko": "괜찮아?",
          "start": 41.263333,
          "end": 42.369063
        },
        {
          "id": "s2-shot11-l5",
          "speaker": "blue",
          "en": "I am okay.",
          "ko": "난 괜찮아.",
          "start": 43.343333,
          "end": 44.444896
        },
        {
          "id": "s2-shot12-l1",
          "speaker": "bubbles",
          "en": "It is not in my basket.",
          "ko": "내 바구니에는 없어.",
          "start": 46.766667,
          "end": 48.543021
        },
        {
          "id": "s2-shot12-l2",
          "speaker": "mini",
          "en": "What is in there?",
          "ko": "그 안에는 뭐가 있니?",
          "start": 50.726667,
          "end": 51.924062
        },
        {
          "id": "s2-shot12-l3",
          "speaker": "bubbles",
          "en": "Only cookies!",
          "ko": "쿠키뿐이야!",
          "start": 52.686667,
          "end": 53.848979
        },
        {
          "id": "s2-shot12-l4",
          "speaker": "puffy",
          "en": "Let us look over there.",
          "ko": "저쪽을 찾아보자.",
          "start": 55.396667,
          "end": 56.866979
        },
        {
          "id": "s2-shot13-l1",
          "speaker": "ollie",
          "en": "Bubbles, did you take it?",
          "ko": "버블스, 네가 가져갔니?",
          "start": 62.835333,
          "end": 65.233396
        },
        {
          "id": "s2-shot13-l2",
          "speaker": "bubbles",
          "en": "No, I did not! I only have cookies.",
          "ko": "아니, 안 가져갔어! 나한테는 쿠키뿐이야.",
          "start": 65.343333,
          "end": 68.96425
        },
        {
          "id": "s2-shot13-l3",
          "speaker": "ollie",
          "en": "Oh.",
          "ko": "아.",
          "start": 70.823333,
          "end": 71.888583
        },
        {
          "id": "s2-shot14-l1",
          "speaker": "puffy",
          "en": "Let us ask everyone.",
          "ko": "모두에게 물어보자.",
          "start": 73.546667,
          "end": 75.095229
        },
        {
          "id": "s2-shot14-l2",
          "speaker": "green",
          "en": "Did anyone move it?",
          "ko": "누가 옮겼니?",
          "start": 78.917167,
          "end": 80.135375
        },
        {
          "id": "s2-shot14-l3",
          "speaker": "mini",
          "en": "I... um...",
          "ko": "나... 음...",
          "start": 81.723167,
          "end": 83.60375
        },
        {
          "id": "s2-shot14-l4",
          "speaker": "green",
          "en": "Does anyone know?",
          "ko": "아는 사람 있니?",
          "start": 84.857167,
          "end": 85.895125
        },
        {
          "id": "s2-shot15-l1",
          "speaker": "blue",
          "en": "Are you okay?",
          "ko": "괜찮아?",
          "start": 88.31,
          "end": 89.340458
        },
        {
          "id": "s2-shot15-l2",
          "speaker": "mini",
          "en": "I am worried.",
          "ko": "걱정돼.",
          "start": 93.65,
          "end": 94.589313
        },
        {
          "id": "s2-shot15-l3",
          "speaker": "blue",
          "en": "I am here with you.",
          "ko": "내가 여기 함께 있어.",
          "start": 95.9585,
          "end": 97.995125
        },
        {
          "id": "s2-shot15-l4",
          "speaker": "mini",
          "en": "Thank you, Blue.",
          "ko": "고마워, 블루.",
          "start": 100.07,
          "end": 101.050396
        },
        {
          "id": "s2-shot16-l1",
          "speaker": "ollie",
          "en": "I am sorry, Bubbles.",
          "ko": "미안해, 버블스.",
          "start": 107.693333,
          "end": 109.729062
        },
        {
          "id": "s2-shot16-l2",
          "speaker": "bubbles",
          "en": "Thank you for saying sorry.",
          "ko": "사과해 줘서 고마워.",
          "start": 110.843333,
          "end": 112.349917
        },
        {
          "id": "s2-shot16-l3",
          "speaker": "ollie",
          "en": "Can we look together?",
          "ko": "같이 찾아볼까?",
          "start": 113.609333,
          "end": 115.695833
        },
        {
          "id": "s2-shot16-l4",
          "speaker": "bubbles",
          "en": "Yes!",
          "ko": "응!",
          "start": 115.813333,
          "end": 116.403021
        },
        {
          "id": "s2-shot17-l1",
          "speaker": "puffy",
          "en": "We can find it together.",
          "ko": "함께 찾을 수 있어.",
          "start": 118.936667,
          "end": 120.764229
        },
        {
          "id": "s2-shot17-l2",
          "speaker": "ollie",
          "en": "Let us find it!",
          "ko": "찾으러 가자!",
          "start": 123.526667,
          "end": 125.187708
        },
        {
          "id": "s2-shot17-l3",
          "speaker": "mini",
          "en": "I can help, too.",
          "ko": "나도 도울 수 있어.",
          "start": 125.706667,
          "end": 126.939646
        },
        {
          "id": "s2-shot17-l4",
          "speaker": "blue",
          "en": "Yes, you can!",
          "ko": "그럼, 너도 할 수 있어!",
          "start": 128.976667,
          "end": 130.469583
        },
        {
          "id": "s2-shot18-l1",
          "speaker": "green",
          "en": "Stop. Look carefully.",
          "ko": "멈춰. 자세히 봐.",
          "start": 134.43,
          "end": 137.012875
        },
        {
          "id": "s2-shot18-l2",
          "speaker": "ollie",
          "en": "What can you see?",
          "ko": "뭐가 보이니?",
          "start": 139.44,
          "end": 141.289667
        },
        {
          "id": "s2-shot18-l3",
          "speaker": "green",
          "en": "A little sparkle!",
          "ko": "작은 반짝임이야!",
          "start": 142.6825,
          "end": 143.794292
        },
        {
          "id": "s2-shot18-l4",
          "speaker": "ollie",
          "en": "Where?",
          "ko": "어디?",
          "start": 144.824,
          "end": 146.061958
        },
        {
          "id": "s2-shot19-l1",
          "speaker": "green",
          "en": "Look! Rainbow sparkles!",
          "ko": "봐! 무지개가 반짝여!",
          "start": 150.623333,
          "end": 153.114062
        },
        {
          "id": "s2-shot19-l2",
          "speaker": "blue",
          "en": "They are from the light!",
          "ko": "등불에서 나온 거야!",
          "start": 154.553333,
          "end": 156.113271
        },
        {
          "id": "s2-shot19-l3",
          "speaker": "green",
          "en": "Here is another one!",
          "ko": "여기 또 하나 있어!",
          "start": 157.783333,
          "end": 159.418125
        },
        {
          "id": "s2-shot19-l4",
          "speaker": "blue",
          "en": "Good job!",
          "ko": "잘했어!",
          "start": 159.903333,
          "end": 160.834042
        },
        {
          "id": "s2-shot20-l1",
          "speaker": "bubbles",
          "en": "Is it on my nose?",
          "ko": "내 코 위에 있니?",
          "start": 166.916667,
          "end": 168.576417
        },
        {
          "id": "s2-shot20-l2",
          "speaker": "mini",
          "en": "Yes! Right there!",
          "ko": "응! 바로 거기!",
          "start": 169.036667,
          "end": 171.237875
        },
        {
          "id": "s2-shot20-l3",
          "speaker": "bubbles",
          "en": "It tickles!",
          "ko": "간지러워!",
          "start": 172.803167,
          "end": 174.206958
