541c9909ab5f","source":"BTS 1 · #60"},"f691aeec8ff7":{"text":"Do you finish your homework?","id":"f691aeec8ff7","source":"BTS 1 · #61"},"eb56c513e1f7":{"text":"Yes, I always finish my homework.","id":"eb56c513e1f7","source":"BTS 1 · #62"},"a6e6325c1498":{"text":"She helps us understand the lesson.","id":"a6e6325c1498","source":"BTS 1 · #64"},"b1a3f213bbc4":{"text":"He explains everything clearly.","id":"b1a3f213bbc4","source":"BTS 1 · #65","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/f8eb689a-1b8b-48ed-8056-0fbd1d138422.webp","imageBytes":12090},"67c7a598561a":{"text":"The lessons are easy to understand.","id":"67c7a598561a","source":"BTS 1 · #66","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/c2e8b46d-b0b6-4255-a195-00710bef3d73.webp","imageBytes":21178},"6b19c86483c9":{"id":"6b19c86483c9","source":"BTS 13 · #48","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/cd8c1f40-a223-442b-96cc-a37d161928b4.webp","imageBytes":19560},"5381e041b039":{"id":"5381e041b039","source":"BTS 17 · #19","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/2cb2c052-b5a6-4484-aa9e-3fe5ca9fca68.webp","imageBytes":8832},"1b4c533705ca":{"id":"1b4c533705ca","source":"BTS 7 · #95","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/a39ab8ee-6f24-4f83-a840-8013177db929.webp","imageBytes":17924},"c26fd13894f3":{"id":"c26fd13894f3","source":"BTS 3 · #63","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/155dffb8-b618-4a5b-843f-2235c5f51070.webp","imageBytes":26292},"2cf48475a23d":{"text":"We study together after school.","id":"2cf48475a23d","source":"BTS 1 · #70"},"e8f8fd9c2677":{"text":"The bell rings at three o'clock.","id":"e8f8fd9c2677","source":"BTS 1 · #71"},"5d12864b9b67":{"text":"School ends at three thirty.","id":"5d12864b9b67","source":"BTS 1 · #72","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1y