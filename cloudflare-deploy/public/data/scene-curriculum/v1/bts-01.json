20688,"duration":4.041667},"cb200a992c18":{"text":"How are you, Karen?","id":"cb200a992c18","source":"BTS 1 · #2","image":"/img/scene-clips/7115.webp","imageBytes":29632,"video":"/videos/scene-clips/7115.mp4","videoBytes":190791,"duration":4.041667},"c364fc630fbe":{"text":"Hi, Ken! How are you?","id":"c364fc630fbe","source":"BTS 1 · #1","image":"/img/scene-clips/7147.webp","imageBytes":18406,"video":"/videos/scene-clips/7147.mp4","videoBytes":168951,"duration":4.041667},"f5f1cd5d6711":{"text":"Do they have scissors?","id":"f5f1cd5d6711","source":"BTS 1 · #23","image":"/img/scene-clips/7171.webp","imageBytes":14594,"video":"/videos/scene-clips/7171.mp4","videoBytes":121813,"duration":4.041667},"c4afd7639dfd":{"text":"I am eleven years old.","id":"c4afd7639dfd","source":"BTS 1 · #46","image":"/img/scene-clips/7172.webp","imageBytes":14926,"video":"/videos/scene-clips/7172.mp4","videoBytes":115383,"duration":4.041667},"60974f04a523":{"text":"I am ready for school.","id":"60974f04a523","source":"BTS 1 · #81","image":"/img/scene-clips/7173.webp","imageBytes":9616,"video":"/videos/scene-clips/7173.mp4","videoBytes":163890,"duration":4.041667},"dfd8d585f867":{"text":"I have a water bottle.","id":"dfd8d585f867","source":"BTS 1 · #89","image":"/img/scene-clips/7174.webp","imageBytes":11908,"video":"/videos/scene-clips/7174.mp4","videoBytes":79658,"duration":4.041667},"c12906b31299":{"text":"That is the whiteboard.","id":"c12906b31299","source":"BTS 1 · #28","image":"/img/scene-clips/7189.webp","imageBytes":8744,"video":"/videos/scene-clips/7189.mp4","videoBytes":79261,"duration":4.041667},"bfc4258fb746":{"text":"I am in the fifth grade.","id":"bfc4258fb746","source":"BTS 1 · #48","image":"/img/scene-clips/7209.webp","imageBytes":32732,"video":"/videos/scene-clips/7209.mp4","videoBytes":77740,"duration":4.041667},"3dc96a27355f":{"text":"We eat in the cafeteria.","id":"3dc96a27355f","source":"BTS 1 · #93","image":"/img/scene-clips/7215.webp","imageBytes":19540,"video":"/videos/scene-clips/7215.mp4","videoBytes":183360,"duration":4.041667}},"examples":["Hi, Ken! How are you?","Hi Jane, how are you? I'm okay. What about you?","Well, I am okay. Are you excited?","School ends at three thirty.","School! Our new teacher is a woman.","Is she scary?","No, she is not. She is so kind!","Wow! That is good.","Let's go to school now!","I am a student.","She is a girl.","He is a boy.","He is a man.","I'm fine too. Thanks! Your backpack looks nice.","Nice to meet you.","How are you? I am fine, thank you.","What is it? It is a notebook.","What is it? It is a ruler.","Does she have a pen?","Do they have scissors?","That is the whiteboard.","Where is the clock? It is on the wall.","Good morning, everyone!","Good afternoon, teacher!","I am very happy to be here.","Welcome to our classroom!","There are many desks in the classroom.","Let me introduce myself. My name is Tom.","The classroom is very clean.","We have a library at school.","The library has many books.","Do you like reading books?","My name is Sarah.","I am eleven years old.","I am in the fifth grade.","Yes, I love school!","School is fun and interesting.","We have math class today.","We play games in P.E. class.","We have English class tomorrow.","What is your favorite subject?","My favorite subject is art.","I like science very much.","Physical education is exciting.","Our teacher gives us homework.","I do my homework at home.","Do you finish your homework?","Yes, I always finish my homework.","She helps us understand the lesson.","The lessons are easy to understand.","He explains everything clearly.","I have many friends at school.","My friend is very kind.","We sit together in class.","We study together after school.","The bell rings at three o'clock.","The bus driver is friendly.","The school bus is big.","I see you at school tomorrow.","Goodbye, everyone!","Have a good day!","See you later!","I am ready for school.","My backpack is heavy.","I have a pencil case too.","There are many pencils inside.","I have erasers and sharpeners.","The eraser is pink.","The sharpener is yellow.","I have a water bottle.","The water bottle is green.","I bring my lunch to school.","Lunch time is at twelve o'clock.","We eat in the cafeteria.","The cafeteria is very large.","The lunch is healthy and yummy.","My lunch is in a lunch box.","I have a sandwich and fruit.","The fruit is fresh and sweet.","I drink milk at lunch."]}
