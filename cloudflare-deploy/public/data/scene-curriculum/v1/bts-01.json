"0b99957b1a91":{"id":"0b99957b1a91","source":"BTS 13 · #38","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/ba27f955-48be-47ec-80bd-d856d5420221.webp","imageBytes":11504,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/a13d7587-f423-47f5-abfc-5d63565b4924.mp4","videoBytes":189540,"duration":5.875},"684b8e75bcf3":{"text":"Lunch time is at twelve o'clock.","id":"684b8e75bcf3","source":"BTS 1 · #92"},"3dc96a27355f":{"text":"We eat in the cafeteria.","id":"3dc96a27355f","source":"BTS 1 · #93","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/e9d2c7c0-9f1a-470a-a3d3-a08966b15a1e.webp","imageBytes":22930},"fc8e4b0a0a9b":{"text":"The cafeteria is very large.","id":"fc8e4b0a0a9b","source":"BTS 1 · #94"},"bcb87b09074f":{"text":"The lunch is healthy and yummy.","id":"bcb87b09074f","source":"BTS 1 · #96"},"892f4295f6bd":{"text":"My lunch is in a lunch box.","id":"892f4295f6bd","source":"BTS 1 · #97"},"66213436e415":{"text":"I have a sandwich and fruit.","id":"66213436e415","source":"BTS 1 · #98"},"bdb9b36cbad2":{"text":"The fruit is fresh and sweet.","id":"bdb9b36cbad2","source":"BTS 1 · #99"},"eecf1e567528":{"text":"I drink milk at lunch.","id":"eecf1e567528","source":"BTS 1 · #100"},"1a12f0a6cd76":{"id":"1a12f0a6cd76","source":"BTS 4 · #10","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/1fdcf23f-6237-48c6-ae21-a77be319b9e1.webp","imageBytes":10896,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/6342dea8-ad97-48ba-8640-1a8437c6a5e1.mp4","videoBytes":235390,"duration":5.875}}}
