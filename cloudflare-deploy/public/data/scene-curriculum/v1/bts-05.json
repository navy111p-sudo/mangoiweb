2.webp","imageBytes":12210,"video":"/videos/scene-clips/7272.mp4","videoBytes":104019,"duration":4.041667},"f705c90b6af8":{"text":"Tuesday comes after Monday.","id":"f705c90b6af8","source":"BTS 5 · #22","image":"/img/scene-clips/7299.webp","imageBytes":5414,"video":"/videos/scene-clips/7299.mp4","videoBytes":73454,"duration":4.041667},"8263c82f5cce":{"text":"It gets cold in the evening.","id":"8263c82f5cce","source":"BTS 5 · #58","image":"/img/scene-clips/7336.webp","imageBytes":11742,"video":"/videos/scene-clips/7336.mp4","videoBytes":91295,"duration":4.041667},"085a33041b34":{"text":"Spring is when flowers bloom.","id":"085a33041b34","source":"BTS 5 · #41","image":"/img/scene-clips/7357.webp","imageBytes":28264,"video":"/videos/scene-clips/7357.mp4","videoBytes":131383,"duration":4.041667},"a69d55366a21":{"text":"Next year I will be thirteen.","id":"a69d55366a21","source":"BTS 5 · #96","image":"/img/scene-clips/7358.webp","imageBytes":21976,"video":"/videos/scene-clips/7358.mp4","videoBytes":141572,"duration":4.041667},"f7263582f006":{"text":"We should enjoy every moment.","id":"f7263582f006","source":"BTS 5 · #99","image":"/img/scene-clips/7359.webp","imageBytes":19628,"video":"/videos/scene-clips/7359.mp4","videoBytes":118264,"duration":4.041667}},"examples":["How many days are there in a week?","What day is it today? Today is Monday.","Tuesday comes after Monday.","Tomorrow is Tuesday.","Yesterday was Sunday.","Saturday and Sunday are the weekend.","What is your favorite day of the week?","What season is it? It is spring.","Spring is when flowers bloom.","It is summer. It is very hot.","It is fall. The leaves are changing colors.","It is winter. It is very cold.","It gets cold in the evening.","Time passes very quickly.","It is three o'clock.","It is half past four.","What time do you wake up?","What time do you go to school?","I go to school at eight thirty.","What time do you go to bed?","Wednesday is halfway done.","Wednesday is the middle of the week.","Thursday comes after Wednesday.","Friday is before the weekend.","I like weekends because I don't go to school.","Tuesday is for learning.","Thursday means the weekend is coming.","We have fun on Saturday.","We rest on Sunday.","The weather is warm in spring.","We go on vacation in summer.","Fall is when leaves change color.","Fall is also called autumn.","We see snow falling.","I like to play outside.","Summer is fun and exciting.","We go to the beach in summer.","We swim in the water.","We eat ice cream.","Fall has beautiful colors.","The leaves are red and yellow.","We wear coats and hats.","We wear warm clothes.","Which season do you like best?","Summer has long days.","The sun is very bright.","How many seasons are there?","Each season has different weather.","What time do you eat breakfast?","What time do you eat lunch?","I eat lunch at twelve.","What time do you eat dinner?","What time do you study?","The afternoon is peaceful.","How many hours in a day?","There are twenty-four hours.","How many minutes in an hour?","There are sixty minutes.","How many seconds in a minute?","I can't believe it's already time.","When is your birthday?","March is in spring.","I am twelve years old now.","Next year I will be thirteen.","Growing up is interesting.","Time keeps passing.","We should enjoy every moment."]}
