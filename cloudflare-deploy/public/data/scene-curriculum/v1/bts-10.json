":"/videos/scene-clips/7106.mp4","videoBytes":125550,"duration":4.041667},"b050924f3d1f":{"text":"I make snow angels.","id":"b050924f3d1f","source":"BTS 10 · #46","image":"/img/scene-clips/7114.webp","imageBytes":20132,"video":"/videos/scene-clips/7114.mp4","videoBytes":179837,"duration":4.041667},"ecfd161902c0":{"text":"It's cloudy outside.","id":"ecfd161902c0","source":"BTS 10 · #3","image":"/img/scene-clips/7141.webp","imageBytes":13210,"video":"/videos/scene-clips/7141.mp4","videoBytes":60612,"duration":4.041667},"1340ba1c7bfe":{"text":"My raincoat is blue.","id":"1340ba1c7bfe","source":"BTS 10 · #40","image":"/img/scene-clips/7142.webp","imageBytes":18928,"video":"/videos/scene-clips/7142.mp4","videoBytes":167471,"duration":4.041667},"1e490f12df81":{"text":"Is it foggy outside?","id":"1e490f12df81","source":"BTS 10 · #73","image":"/img/scene-clips/7143.webp","imageBytes":4510,"video":"/videos/scene-clips/7143.mp4","videoBytes":46709,"duration":4.041667},"fc4a40bb7044":{"text":"What is the dew point?","id":"fc4a40bb7044","source":"BTS 10 · #77","image":"/img/scene-clips/7180.webp","imageBytes":15572,"video":"/videos/scene-clips/7180.mp4","videoBytes":118682,"duration":4.041667},"9804b23f540f":{"text":"Do you wear sunscreen?","id":"9804b23f540f","source":"BTS 10 · #85","image":"/img/scene-clips/7181.webp","imageBytes":15074,"video":"/videos/scene-clips/7181.mp4","videoBytes":127190,"duration":4.041667},"6181eb3355f7":{"text":"What happens in autumn?","id":"6181eb3355f7","source":"BTS 10 · #59","image":"/img/scene-clips/7187.webp","imageBytes":44744,"video":"/videos/scene-clips/7187.mp4","videoBytes":279080,"duration":4.041667},"6fe4191c12a6":{"text":"Do you like rainy days?","id":"6fe4191c12a6","source":"BTS 10 · #16","image":"/img/scene-clips/7195.webp","imageBytes":17768,"video":"/videos/scene-clips/7195.mp4","videoBytes":238835,"duration":4.041667},"209b217a6ec6":{"text":"Yes, wear a heavy coat.","id":"209b217a6ec6","source":"BTS 10 · #28","image":"/img/scene-clips/7196.webp","imageBytes":10986,"video":"/videos/scene-clips/7196.mp4","videoBytes":140129,"duration":4.041667},"fda9c4e055be":{"text":"Is it slippery outside?","id":"fda9c4e055be","source":"BTS 10 · #43","image":"/img/scene-clips/7197.webp","imageBytes":9854,"video":"/videos/scene-clips/7197.mp4","videoBytes":113444,"duration":4.041667},"d41e89e92bd2":{"text":"It will be mostly sunny.","id":"d41e89e92bd2","source":"BTS 10 · #22","image":"/img/scene-clips/7210.webp","imageBytes":9488,"video":"/videos/scene-clips/7210.mp4","videoBytes":67020,"duration":4.041667},"9019eef418bc":{"text":"Do you have an umbrella?","id":"9019eef418bc","source":"BTS 10 · #37","image":"/img/scene-clips/7221.webp","imageBytes":13422,"video":"/videos/scene-clips/7221.mp4","videoBytes":92096,"duration":4.041667},"30ab63bd8e04":{"text":"Yes, I help my dad shovel.","id":"30ab63bd8e04","source":"BTS 10 · #54","image":"/img/scene-clips/7267.webp","imageBytes":23838,"video":"/videos/scene-clips/7267.mp4","videoBytes":162426,"duration":4.041667},"d72a0a5b0656":{"text":"Do you like thunderstorms?","id":"d72a0a5b0656","source":"BTS 10 · #29","image":"/img/scene-clips/7275.webp","imageBytes":7538,"video":"/videos/scene-clips/7275.mp4","videoBytes":83544,"duration":4.041667}},"examples":["How's the weather in your city?","Do you like rainy days?","It's windy today. Hold on to your hat!","It will be mostly sunny.","It's sunny today. I love it!","It's cloudy outside.","It's raining. Don't forget your umbrella.","It's snowing! Let's build a snowman.","It's very hot. Let's get some ice cream.","It's very cold. Put on your jacket.","In summer, it is usually hot and humid.","July is usually the hottest.","Is it humid today?","In winter, it is cold and sometimes snowy.","What do you do when it rains?","I stay inside and read a book.","What do you do on a sunny day?","I go to the park and play outside.","No, I prefer cooler weather.","The temperature is thirty degrees today.","Is it going to rain tomorrow?","No, but I've heard of them.","What's the forecast for next week?","Do you check the weather before going out?","Yes, I always check the weather.","Yes, wear a heavy coat.","You should wear a light shirt.","It's freezing outside!","Do you like thunderstorms?","No, they scare me.","Have you ever seen lightning?","Yes, I saw lightning last night.","Can you hear the thunder?","Yes, the thunder is very loud.","It's raining cats and dogs!","Yes, it's raining very hard.","The leaves turn red and fall.","What color is your raincoat?","My raincoat is blue.","Do you like playing in the rain?","Yes, I like jumping in puddles.","Is it slippery outside?","Yes, be careful not to fall.","I make snow angels.","Do you like building snowmen?","Yes, it's very fun!","Have you ever had a snowball fight?","Yes, I had one with my friends.","Yes, the roads are very icy.","Yes, I help my dad shovel.","What's your favorite season?","I like spring the best.","It's warm and the flowers bloom.","What happens in autumn?","Yes, the weather is pleasant.","What's the hottest month?","January is usually the coldest.","Do you like the heat?","The air is very dry today.","Yes, I need to use lotion.","Is it foggy outside?","Yes, you can't see very far.","Do you need glasses on foggy days?","What is the dew point?","It's when water condenses.","Have you ever seen a double rainbow?","Yes! It's very beautiful.","What causes a rainbow?","Light and water create a rainbow.","Do you wear sunscreen?","I use SPF fifty.","Do you wear sunglasses?","Yes, I wear them when it's bright.","Have you ever gotten a sunburn?","Yes, once on vacation.","How do you protect yourself from the heat?","I drink lots of water.","Do you use a fan?","I like mild and sunny weather.","Do you like extremes in weather?","No, I prefer moderate weather."]}
