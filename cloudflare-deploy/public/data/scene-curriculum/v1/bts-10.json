},{"word":"sunscreen","sourceIndex":85,"scene":"9804b23f540f"},{"word":"spf","sourceIndex":88,"scene":"526dbbd92ff5"},{"word":"fifty","sourceIndex":88,"scene":"526dbbd92ff5"},{"word":"sunglasses","sourceIndex":89,"scene":"91798619b1e4"},{"word":"bright","sourceIndex":90,"scene":"9d10412a9664"},{"word":"gotten","sourceIndex":91,"scene":"679a0e671176"},{"word":"sunburn","sourceIndex":91,"scene":"679a0e671176"},{"word":"once","sourceIndex":92,"scene":"a3fbe2b4e266"},{"word":"vacation","sourceIndex":92,"scene":"a3fbe2b4e266"},{"word":"protect","sourceIndex":93,"scene":"16e1b368cd42"},{"word":"drink","sourceIndex":94,"scene":"4877248fa57f"},{"word":"lots","sourceIndex":94,"scene":"4877248fa57f"},{"word":"fan","sourceIndex":95,"scene":"847128dd5d29"},{"word":"mild","sourceIndex":98,"scene":"5c82bc9fc447"},{"word":"extremes","sourceIndex":99,"scene":"c3c338466265"},{"word":"moderate","sourceIndex":100,"scene":"2b538ef8e809"}],"clips":[{"scene":"7288363c2735","sourceIndex":4}],"scenes":{"fde048fbbf97":{"text":"How's the weather in your city?","id":"fde048fbbf97","source":"BTS 10 · #9","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/92c10159-8d3d-48e6-8cb6-62d749ba74a7.webp","imageBytes":4456},"6fe4191c12a6":{"text":"Do you like rainy days?","id":"6fe4191c12a6","source":"BTS 10 · #16","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/f1e1294c-820e-45e2-ada9-bc141c033ae8.webp","imageBytes":10902},"56e1871014d4":{"text":"It's windy today. Hold on to your hat!","id":"56e1871014d4","source":"BTS 10 · #6","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/37a55e30-6d10-4922-b987-d6ba268ffc7b.webp","imageBytes":23636},"d41e89e92bd2":{"text":"It will be mostly sunny.","id":"d41e89e92bd2","source":"BTS 10 · #22","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/1f2902d2-787c-4ed3-9f94-198a4c077c4c.webp","imageBytes":35302},"76b3bc3245bc":{"text":"It's sunny today. I love it!","id":"76b3bc3245bc","source":"BTS 10 · #2"},"ecfd161902c0":{"text":"It's cloudy outside.","id":"ecfd161902c0","source":"BTS 10 · #3","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/8bfe5943-a9d7-4f18-be08-862f38fc2bb5.webp","imageBytes":39666},"7288363c2735":{"text":"It's raining. Don't forget your umbrella.","id":"7288363c2735","source":"BTS 10 · #4","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/1a9c160a-dc56-4bf2-b2d7-e4244e6c4b9f.webp","imageBytes":12668,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/8a80ebb2-d533-4301-82ec-7fd00a082229.mp4","videoBytes":201326,"duration":5.875},"866d0b134b16":{"text":"It's snowing! Let's build a snowman.","id":"866d0b134b16","source":"BTS 10 · #5","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/5b9af3cd-6484-4867-a751-f5cb967ffc7c.webp","imageBytes":16980},"f08935f625e9":{"text":"It's very hot. Let's get some ice cream.","id":"f08935f625e9","source":"BTS 10 · #7","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/49da8f8c-a43d-4468-9b86-92600a4696e9.webp","imageBytes":6616},"dd54691d01ec":{"text":"It's very cold. Put on your jacket.","id":"dd54691d01ec","source":"BTS 10 · #8","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/7985fa14-8ad0-4f60-a745-2402fdd4830d.webp","imageBytes":19152},"1aed2ca449a0":{"text":"In summer, it is usually hot and humid.","id":"1aed2ca449a0","source":"BTS 10 · #10"},"5d4704aab8eb":{"text":"July is usually the hottest.","id":"5d4704aab8eb","source":"BTS 10 · #64","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/ac288228-6ed4-41e1-a0cf-b2b0755b9329.webp","imageBytes":16484},"e13c971d93dd":{"text":"Is it humid today?","id":"e13c971d93dd","source":"BTS 10 · #69","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/554a3d2c-6e9f-45be-a10e-9d43e1f87033.webp","imageBytes":48184},"a8bf50f54fff":{"text":"In winter, it is cold and sometimes snowy.","id":"a8bf50f54fff","source":"BTS 10 · #11","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/e56e70f2-31cd-470f-9649-b41f15bee0ca.webp","imageBytes":43746},"16af446a14a6":{"text":"What do you do when it rains?","id":"16af446a14a6","source":"BTS 10 · #12","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/70874229-df47-4c1f-bc1a-6a2d8540d28b.webp","imageBytes":28182},"9e45c47cbe3b":{"text":"I stay inside and read a book.","id":"9e45c47cbe3b","source":"BTS 10 · #13"},"b95108e18e80":{"text":"What do you do on a sunny day?","id":"b95108e18e80","source":"BTS 10 · #14"},"975add75b4cb":{"text":"I go to the park and play outside.","id":"975add75b4cb","source":"BTS 10 · #15"},"713a571070f5":{"text":"No, I prefer cooler weather.","id":"713a571070f5","source":"BTS 10 · #68","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/25a1e5e0-5f2d-4b40-8eb1-1cb88bd0a7a9.webp","imageBytes":37586},"db3e066b775c":{"text":"The temperature is thirty degrees today.","id":"db3e066b775c","source":"BTS 10 · #18"},"c1e784d3a8af":{"text":"Is it going to rain tomorrow?","id":"c1e784d3a8af","source":"BTS 10 · #19"},"b0ade0bf4673":{"text":"No, but I've heard of them.","id":"b0ade0bf4673","source":"BTS 10 · #82","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/38ff41d8-67cf-44ea-b914-e3062a6aeedc.webp","imageBytes":20268},"0960077d1435":{"text":"What's the forecast for next week?","id":"0960077d1435","source":"BTS 10 · #21","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/8bfe5943-a9d7-4f18-be08-862f38fc2bb5.webp","imageBytes":39666},"a99b9546a55d":{"text":"Do you check the weather before going out?","id":"a99b9546a55d","source":"BTS 10 · #23"},"44b36cbc48eb":{"text":"Yes, I always check the weather.","id":"44b36cbc48eb","source":"BTS 10 · #24"},"209b217a6ec6":{"text":"Yes, wear a heavy coat.","id":"209b217a6ec6","source":"BTS 10 · #28","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/235b9105-2e7a-4a4f-9417-44d295e37a3a.webp","imageBytes":30698},"2f4780473559":{"text":"You should wear a light shirt.","id":"2f4780473559","source":"BTS 10 · #26"},"071b68cc8075":{"text":"It's freezing outside!","id":"071b68cc8075","source":"BTS 10 · #27"},"d72a0a5b0656":{"text":"Do you like thunderstorms?","id":"d72a0a5b0656","source":"BTS 10 · #29","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/27696838-8fe5-450e-b0ab-00108d134a94.webp","imageBytes":3836},"e15ebfc52b2c":{"text":"No, they scare me.","id":"e15ebfc52b2c","source":"BTS 10 · #30","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/a8253e23-d8cd-405a-b04d-e66147a8ef88.webp","imageBytes":14148},"62e4523da174":{"text":"Have you ever seen lightning?","id":"62e4523da174","source":"BTS 10 · #31","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/8a56269b-6ff9-472c-accb-054d2e7e2a53.webp","imageBytes":3602},"a9c7b12c1e3f":{"text":"Yes, I saw lightning last night.","id":"a9c7b12c1e3f","source":"BTS 10 · #32"},"65fe664f2920":{"text":"Can you hear the thunder?","id":"65fe664f2920","source":"BTS 10 · #33"},"2151240905c6":{"text":"Yes, the thunder is very loud.","id":"2151240905c6","source":"BTS 10 · #34","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/356b33c5-3784-43f5-a8c2-4ce51d251503.webp","imageBytes":3104},"40af0deb0e15":{"text":"It's raining cats and dogs!","id":"40af0deb0e15","source":"BTS 10 · #35","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/136d73cd-7f20-4746-9ff6-7f3f57b28d7d.webp","imageBytes":30786},"5818ba2583f1":{"text":"Yes, it's raining very hard.","id":"5818ba2583f1","source":"BTS 10 · #36"},"9fda96571b06":{"text":"The leaves turn red and fall.","id":"9fda96571b06","source":"BTS 10 · #60","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/e3a0739c-3457-498c-a880-80a9fbde93ce.webp","imageBytes":67144},"099c50fca3f8":{"text":"What color is your raincoat?","id":"099c50fca3f8","source":"BTS 10 · #39"},"1340ba1c7bfe":{"text":"My raincoat is blue.","id":"1340ba1c7bfe","source":"BTS 10 · #40","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/107af103-a4ed-45b1-9c7b-681f6250fe1e.webp","imageBytes":20908},"d1bc5d51d0d2":{"text":"Do you like playing in the rain?","id":"d1bc5d51d0d2","source":"BTS 10 · #41"},"bb5c1af474f6":{"text":"Yes, I like jumping in puddles.","id":"bb5c1af474f6","source":"BTS 10 · #42","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/366953b0-8d7f-44e5-bd1e-388b6ecd844b.webp","imageBytes":27374},"fda9c4e055be":{"text":"Is it slippery outside?","id":"fda9c4e055be","source":"BTS 10 · #43","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/67158169-787b-4ac5-9d70-5eb019f2b95a.webp","imageBytes":37894},"b761e74b3c54":{"text":"Yes, be careful not to fall.","id":"b761e74b3c54","source":"BTS 10 · #44"},"b050924f3d1f":{"text":"I make snow angels.","id":"b050924f3d1f","source":"BTS 10 · #46","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/06dcf501-f3cf-4835-8444-abc635e05e48.webp","imageBytes":11204},"105ffc1c095a":{"text":"Do you like building snowmen?","id":"105ffc1c095a","source":"BTS 10 · #47","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/690eba49-49a1-4924-83a5-407f54e0ffb9.webp","imageBytes":14244},"97c7e2b061b7":{"text":"Yes, it's very fun!","id":"97c7e2b061b7","source":"BTS 10 · #48"},"e265056df7e2":{"text":"Have you ever had a snowball fight?","id":"e265056df7e2","source":"BTS 10 · #49","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/9cf763de-cd40-4c46-ada3-5e5fe00a8bc8.webp","imageBytes":21192},"0c0917dc6acd":{"text":"Yes, I had one with my friends.","id":"0c0917dc6acd","source":"BTS 10 · #50"},"ae2395caacbb":{"text":"Yes, the roads are very icy.","id":"ae2395caacbb","source":"BTS 10 · #52","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/bc7eaf9f-8303-46b8-9eb3-50de8e3e96b2.webp","imageBytes":36674},"30ab63bd8e04":{"text":"Yes, I help my dad shovel.","id":"30ab63bd8e04","source":"BTS 10 · #54","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/e8f41a88-9376-4587-8eff-b257f7a7e8ad.webp","imageBytes":23518},"3457ea5d33aa":{"id":"3457ea5d33aa","source":"BTS 16 · #16","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/acf8cba6-f3ac-4764-9d62-2b4efac82738.webp","imageBytes":16084,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/82768f9a-0d2d-4b83-95ad-e80642bfc47d.mp4","videoBytes":154984,"duration":5.875},"7c7b9da2d8bc":{"text":"What's your favorite season?","id":"7c7b9da2d8bc","source":"BTS 10 · #55"},"9a73aac0f7d6":{"text":"I like spring the best.","id":"9a73aac0f7d6","source":"BTS 10 · #56"},"7dadf1132d15":{"text":"It's warm and the flowers bloom.","id":"7dadf1132d15","source":"BTS 10 · #58"},"6181eb3355f7":{"text":"What happens in autumn?","id":"6181eb3355f7","source":"BTS 10 · #59","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/fec5e57f-a339-4f7a-b518-a3214919d802.webp","imageBytes":66502},"25435273e081":{"id":"25435273e081","source":"BTS 5 · #10","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/180fb99f-f87b-44ed-9bf2-beaa4765c731.webp","imageBytes":42478,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/3ace69a6-e4da-4d57-b750-a04e97dabb93.mp4","videoBytes":496756,"duration":5.875},"76ff506dcae7":{"text":"Yes, the weather is pleasant.","id":"76ff506dcae7","source":"BTS 10 · #62","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/50713042-3aaa-459c-8f2c-9c44afbdf4f5.webp","imageBytes":62450},"e61e9f0e2255":{"text":"What's the hottest month?","id":"e61e9f0e2255","source":"BTS 10 · #63"},"3ffadf650bc7":{"text":"January is usually the coldest.","id":"3ffadf650bc7","source":"BTS 10 · #66","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/013dacb5-7170-4c6e-8a8f-e23bef38e2ee.webp","imageBytes":25402},"7d0bff8ef4c3":{"text":"Do you like the heat?","id":"7d0bff8ef4c3","source":"BTS 10 · #67"},"9a0270d62bf8":{"text":"The air is very dry today.","id":"9a0270d62bf8","source":"BTS 10 · #71"},"35c775943355":{"text":"Yes, I need to use lotion.","id":"35c775943355","source":"BTS 10 · #72","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/f1476ce4-09fb-4198-bcbb-7e6a05a1bade.webp","imageBytes":6530},"1e490f12df81":{"text":"Is it foggy outside?","id":"1e490f12df81","source":"BTS 10 · #73","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/fe654021-c416-4c29-a1dc-f6249bbd96f7.webp","imageBytes":23816},"45f2fb49bbf7":{"text":"Yes, you can't see very far.","id":"45f2fb49bbf7","source":"BTS 10 · #74"},"b511154e5662":{"text":"Do you need glasses on foggy days?","id":"b511154e5662","source":"BTS 10 · #75"},"fc4a40bb7044":{"text":"What is the dew point?","id":"fc4a40bb7044","source":"BTS 10 · #77","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/c55d672d-a0b5-4a20-bec2-6c0a6d8b2026.webp","imageBytes":59814},"077bdc2bcbb3":{"text":"It's when water condenses.","id":"077bdc2bcbb3","source":"BTS 10 · #78","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/2d258b0a-cd9b-4bbe-bfca-ba8a027e0d01.webp","imageBytes":17240},"754758a48ade":{"text":"Have you ever seen a double rainbow?","id":"754758a48ade","source":"BTS 10 · #81","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/20b3ff23-ddad-4d56-a85b-7511f50807a2.webp","imageBytes":2800},"65f89f3511f3":{"text":"Yes! It's very beautiful.","id":"65f89f3511f3","source":"BTS 10 · #80"},"83aacfeea7d5":{"text":"What causes a rainbow?","id":"83aacfeea7d5","source":"BTS 10 · #83"},"4ed975b42f3f":{"text":"Light and water create a rainbow.","id":"4ed975b42f3f","source":"BTS 10 · #84"},"9804b23f540f":{"text":"Do you wear sunscreen?","id":"9804b23f540f","source":"BTS 10 · #85","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/7be7f51b-eb43-44d9-862c-2a698f443cb1.webp","imageBytes":15010},"526dbbd92ff5":{"text":"I use SPF fifty.","id":"526dbbd92ff5","source":"BTS 10 · #88","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/dca4da8e-0677-40cf-9b12-3dd9b1ba7cff.webp","imageBytes":6788},"91798619b1e4":{"text":"Do you wear sunglasses?","id":"91798619b1e4","source":"BTS 10 · #89"},"9d10412a9664":{"text":"Yes, I wear them when it's bright.","id":"9d10412a9664","source":"BTS 10 · #90"},"679a0e671176":{"text":"Have you ever gotten a sunburn?","id":"679a0e671176","source":"BTS 10 · #91","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/cdf2f19f-b8eb-43e6-9c44-8987879e401f.webp","imageBytes":13686},"a3fbe2b4e266":{"text":"Yes, once on vacation.","id":"a3fbe2b4e266","source":"BTS 10 · #92"},"16e1b368cd42":{"text":"How do you protect yourself from the heat?","id":"16e1b368cd42","source":"BTS 10 · #93"},"4877248fa57f":{"text":"I drink lots of water.","id":"4877248fa57f","source":"BTS 10 · #94"},"847128dd5d29":{"text":"Do you use a fan?","id":"847128dd5d29","source":"BTS 10 · #95"},"5c82bc9fc447":{"text":"I like mild and sunny weather.","id":"5c82bc9fc447","source":"BTS 10 · #98","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/9c3245b2-7608-4d5b-853e-4afdfc3f1b31.webp","imageBytes":8188},"c3c338466265":{"text":"Do you like extremes in weather?","id":"c3c338466265","source":"BTS 10 · #99","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/12454f7e-6f63-4811-83ab-6dd2adaf4c96.webp","imageBytes":6880},"2b538ef8e809":{"text":"No, I prefer moderate weather.","id":"2b538ef8e809","source":"BTS 10 · #100","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/b6624a2b-49bc-4556-838f-0f3bbbfd70db.webp","imageBytes":39020}}}
