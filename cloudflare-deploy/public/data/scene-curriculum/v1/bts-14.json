"d0ded9022d54":{"text":"I will go to the library.","id":"d0ded9022d54","source":"BTS 14 · #56"},"b3e9791ac552":{"text":"Will you borrow any books?","id":"b3e9791ac552","source":"BTS 14 · #57"},"334f4dd98199":{"text":"Yes, I will look for a mystery book.","id":"334f4dd98199","source":"BTS 14 · #58"},"3d20b3fc3de2":{"text":"How long will you stay there?","id":"3d20b3fc3de2","source":"BTS 14 · #59"},"1b28210066be":{"text":"I will stay for about an hour.","id":"1b28210066be","source":"BTS 14 · #60"},"8514ddbc8a58":{"text":"Will you come home for dinner?","id":"8514ddbc8a58","source":"BTS 14 · #61"},"61ea0baa4a17":{"text":"Yes, I will be home by six o'clock.","id":"61ea0baa4a17","source":"BTS 14 · #62"},"fe7fce0d234b":{"id":"fe7fce0d234b","source":"SIU Basic 2 · #28","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/1d478d38-807e-4727-8e62-b03b99803489.webp","imageBytes":12944,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/3d02ae8c-7cd8-4d61-8e45-902f10c93678.mp4","videoBytes":262134,"duration":5.875},"66a878b0f2fd":{"text":"We will have grilled chicken and vegetables.","id":"66a878b0f2fd","source":"BTS 14 · #64"},"032fb469529b":{"text":"Will you help cook?","id":"032fb469529b","source":"BTS 14 · #65"},"42ac4055e12d":{"text":"I will help set the table.","id":"42ac4055e12d","source":"BTS 14 · #66"},"ef4aa6ac57c8":{"id":"ef4aa6ac57c8","source":"BTS 21 · #18","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/317f89fd-cd7e-44d8-9859-183d323f600a.webp","imageBytes":16012,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/b011d0c0-b20e-4023-84d0-7a150821fd07.mp4","videoBytes":501386,"duration":5.875},"53967ff95ea2":{"text":"I will watch some television.","id":"53967ff95ea2","source":"BTS 14 · #68"},"9d9d8635adb1":{"text":"What show will you watch?","id":"9d9d8635adb1","source":"BTS 14 · #69"},"bd968913106a":{"text":"I will watch my favorite comedy show.","i