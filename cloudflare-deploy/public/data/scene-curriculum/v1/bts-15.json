18762a61374e","sourceIndex":7}],"scenes":{"e1e56e346c6b":{"text":"This is a true story.","id":"e1e56e346c6b","source":"BTS 15 · #1"},"28dc518069a7":{"text":"That story is fiction. It is not real.","id":"28dc518069a7","source":"BTS 15 · #2"},"a61c8abfcca7":{"text":"Do you like reading stories?","id":"a61c8abfcca7","source":"BTS 15 · #3"},"7b3101c3585b":{"text":"What is your favorite book?","id":"7b3101c3585b","source":"BTS 15 · #4"},"2d06913038f4":{"text":"Once upon a time, there was a brave knight.","id":"2d06913038f4","source":"BTS 15 · #6","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/1edb0f81-590d-4f95-88e5-b46b4ee3a740.webp","imageBytes":14188},"18762a61374e":{"text":"The princess lived in a big castle.","id":"18762a61374e","source":"BTS 15 · #7","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/9ed7dd2a-eb52-4a19-a978-d5cb7d2ec244.webp","imageBytes":20002,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/8f439290-128a-4cc5-be07-4105a45ddfcf.mp4","videoBytes":259424,"duration":5.875},"6000e1e50227":{"text":"The dragon was very scary.","id":"6000e1e50227","source":"BTS 15 · #8","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/4641b403-015b-4b2b-9630-4ac16508012a.webp","imageBytes":27860},"1ec8b2e40cb8":{"text":"In the end, they lived happily ever after.","id":"1ec8b2e40cb8","source":"BTS 15 · #9","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/eb79f1eb-cc0a-4487-9989-85573c498cf6.webp","imageBytes":12312},"b5bfee08547d":{"text":"Have you ever read a biography?","id":"b5bfee08547d","source":"BTS 15 · #10"},"efbdbdf271dd":{"text":"A biography is a true story about a real person.","id":"efbdbdf271dd","source":"BTS 15 · #11"},"b6d8712eae78":{"text":"Fiction stories come from the writer's imagination.","id":"b6d8712eae78","source":"BTS 15 · #12","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/7129b477-f9dd-4a81-a01a-6cf7f1d9a338.webp","imageBytes":8814},"18843764f7b6":{"text":"What kind of stories do you like?","id":"18843764f7b6","source":"BTS 15 · #13"},"864e8a5dd5f1":{"text":"I like adventure stories.","id":"864e8a5dd5f1","source":"BTS 15 · #14"},"80f50b6a7ade":{"text":"She prefers mystery stories.","id":"80f50b6a7ade","source":"BTS 15 · #15","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/1abf0b3b-a57b-4126-81b7-07702d7369a7.webp","imageBytes":8762},"2465d13522b5":{"text":"Can you tell me a story?","id":"2465d13522b5","source":"BTS 15 · #16"},"194da0b6fa4a":{"text":"Let me tell you about what happened.","id":"194da0b6fa4a","source":"BTS 15 · #17"},"a5593db8a560":{"text":"This really happened to me last year.","id":"a5593db8a560","source":"BTS 15 · #18"},"9d7ac9cbc010":{"text":"The most interesting part of the story was the ending.","id":"9d7ac9cbc010","source":"BTS 15 · #19"},"eacfe9d3e82c":{"text":"Who is your favorite character in the story?","id":"eacfe9d3e82c","source":"BTS 15 · #20"},"1e4e8c544e2c":{"text":"I like stories about superheroes.","id":"1e4e8c544e2c","source":"BTS 15 · #21","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/e982b547-541e-4c9b-86b6-187e52decc7c.webp","imageBytes":8734},"93162c095890":{"text":"Marvel and DC characters are fictional.","id":"93162c095890","source":"BTS 15 · #22","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/79bd4ba6-80d8-4fb8-abb6-9704bbad6fd2.webp","imageBytes":17476},"294bb9bb5c70":{"text":"Some stories are based on true events.","id":"294bb9bb5c70","source":"BTS 15 · #23"},"84fb207ca7cf":{"text":"The movie was adapted from a book.","id":"84fb207ca7cf","source":"BTS 15 · #24"},"a3cc77af251b":{"text":"The author wrote this story from her imagination.","id":"a3cc77af251b","source":"BTS 15 · #25"},"e294c6c47c9b":{"text":"Have you read Harry Potter?","id":"e294c6c47c9b","source":"BTS 15 · #26"},"f8d9e7d6c52e":{"text":"Yes, it is a great fantasy series.","id":"f8d9e7d6c52e","source":"BTS 15 · #27"},"4abc7c4dabdd":{"text":"The Lord of the Rings is also fiction.","id":"4abc7c4dabdd","source":"BTS 15 · #28","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/9e9532ec-6895-433a-be4c-45f9a959bd5d.webp","imageBytes":41960},"8fa373b282ed":{"text":"J.R.R. Tolkien created Middle-earth.","id":"8fa373b282ed","source":"BTS 15 · #29","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/cdb43174-1305-4000-9fb2-5a814ccaaded.webp","imageBytes":34482},"ed2804d1c3fd":{"text":"What is your opinion about the story?","id":"ed2804d1c3fd","source":"BTS 15 · #30"},"44e0aaa60551":{"text":"I think it was interesting and exciting.","id":"44e0aaa60551","source":"BTS 15 · #31"},"f355165b851a":{"text":"Did you enjoy reading the ending?","id":"f355165b851a","source":"BTS 15 · #32"},"a525c79c87fa":{"text":"Yes, I liked how everything was resolved.","id":"a525c79c87fa","source":"BTS 15 · #33"},"859b01de0177":{"text":"Would you recommend this book to a friend?","id":"859b01de0177","source":"BTS 15 · #34"},"2228f5afe82e":{"id":"2228f5afe82e","source":"BTS 32 · #17","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/faf03b99-294e-4a70-b776-b112b39ed749.webp","imageBytes":22128,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/1bc88374-c728-4eee-ab2d-a2decfeb2c99.mp4","videoBytes":182068,"duration":5.875},"eef5a3834c56":{"text":"Yes, I think everyone should read it.","id":"eef5a3834c56","source":"BTS 15 · #35"},"f0802f7a14dc":{"text":"How long did it take you to finish the book?","id":"f0802f7a14dc","source":"BTS 15 · #36"},"c5700acea0ad":{"text":"It took me three weeks to read it.","id":"c5700acea0ad","source":"BTS 15 · #37"},"ad5f31f00ac4":{"text":"Do you read before going to bed?","id":"ad5f31f00ac4","source":"BTS 15 · #38"},"d98b031c226d":{"id":"d98b031c226d","source":"BTS 6 · #7","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/11b4ea64-0da9-4ca5-854d-1b7567ea206a.webp","imageBytes":9224,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/91ae4e0c-b919-4acf-8833-f309953241e1.mp4","videoBytes":101346,"duration":5.875},"d156d25ca1f3":{"text":"Yes, I read for about thirty minutes.","id":"d156d25ca1f3","source":"BTS 15 · #39"},"a29df9b47334":{"text":"What genre do you prefer?","id":"a29df9b47334","source":"BTS 15 · #40"},"6c656168e1a5":{"id":"6c656168e1a5","source":"SIU Basic 3 · #43","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/e901ca1a-54ba-48a8-b5a3-0ce3adad9f9c.webp","imageBytes":18360,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/3f65bf67-41c1-49f8-8d2f-9fa3424dbc18.mp4","videoBytes":111852,"duration":5.875},"ee2994ca21e8":{"text":"Have you read any novels by Stephen King?","id":"ee2994ca21e8","source":"BTS 15 · #42"},"e8c76f68d467":{"text":"Yes, his stories are very suspenseful.","id":"e8c76f68d467","source":"BTS 15 · #43","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/89b6b678-c80d-4b3c-ab0b-ce6d948b38af.webp","imageBytes":10724},"16af212c39f2":{"text":"Most of them are pure fiction.","id":"16af212c39f2","source":"BTS 15 · #45","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/5ce81377-6ff7-4ee1-9ef7-58f0901f8776.webp","imageBytes":33266},"451ae4a58363":{"text":"What is the scariest story you have read?","id":"451ae4a58363","source":"BTS 15 · #46","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/7e4b39ad-e534-4479-8ff6-a9ee1d36fe35.webp","imageBytes":42706},"9ffbd5d61586":{"text":"The Ring was very frightening.","id":"9ffbd5d61586","source":"BTS 15 · #47","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/45d8f623-1a66-4071-b74b-dce1d6ddff0b.webp","imageBytes":9958},"d5ad7d2911c7":{"text":"Did it give you nightmares?","id":"d5ad7d2911c7","source":"BTS 15 · #48","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/0a84819c-8aee-40ed-b196-ac0e6af15ffc.webp","imageBytes":76220},"2929b07f4bde":{"text":"No, but it was definitely scary.","id":"2929b07f4bde","source":"BTS 15 · #49","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/cb3a6a7c-753d-4b0c-bed6-8b48b2ccca2e.webp","imageBytes":5634},"8148bfa45b69":{"text":"Do you like horror stories?","id":"8148bfa45b69","source":"BTS 15 · #50"},"95a50ba966ce":{"text":"Sometimes, but I prefer happy endings.","id":"95a50ba966ce","source":"BTS 15 · #51","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/7439d8f6-4e5d-4251-81db-ad5fd87e4e68.webp","imageBytes":12944},"bd623e13705b":{"text":"Have you read any romantic stories?","id":"bd623e13705b","source":"BTS 15 · #52","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/ac66f3f7-e128-4b1f-a57f-f3f78d368d25.webp","imageBytes":16480},"6aba9171029f":{"text":"Yes, I enjoy love stories.","id":"6aba9171029f","source":"BTS 15 · #53"},"24f5846f305b":{"text":"What makes a good love story?","id":"24f5846f305b","source":"BTS 15 · #54","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/66c71b69-b106-41a3-8aba-514df6b3a68a.webp","imageBytes":13974},"8e85244c9507":{"text":"The characters must really care about each other.","id":"8e85244c9507","source":"BTS 15 · #55"},"f442f6064ba4":{"text":"Have you read any poetry?","id":"f442f6064ba4","source":"BTS 15 · #56"},"cfcbb10db4ad":{"text":"Yes, poetry can be very beautiful.","id":"cfcbb10db4ad","source":"BTS 15 · #57"},"c3c2596b1ce1":{"text":"Is poetry easier or harder to understand than stories?","id":"c3c2596b1ce1","source":"BTS 15 · #58"},"d2c26efe217f":{"text":"Do you prefer reading or listening to stories?","id":"d2c26efe217f","source":"BTS 15 · #60","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/7f0fcd21-0e29-4a17-b3a6-6d5adae905f8.webp","imageBytes":13460},"f2603a52ee66":{"text":"I prefer reading because I can imagine the story.","id":"f2603a52ee66","source":"BTS 15 · #61"},"3fc6ee9d31f4":{"text":"What are some classic books?","id":"3fc6ee9d31f4","source":"BTS 15 · #62"},"17291e143afa":{"text":"Pride and Prejudice and Wuthering Heights are classics.","id":"17291e143afa","source":"BTS 15 · #63","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/b35df8e9-35c0-40f8-bf64-0d13d4abcbbd.webp","imageBytes":18052},"beaef158752c":{"text":"When were these books written?","id":"beaef158752c","source":"BTS 15 · #64","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/55cd3ffe-54cb-4f95-82a4-f55e2de56c21.webp","imageBytes":12678},"dd888cc82ff8":{"text":"Are they still popular today?","id":"dd888cc82ff8","source":"BTS 15 · #66"},"b6ceef62c569":{"text":"Yes, many people still read them.","id":"b6ceef62c569","source":"BTS 15 · #67"},"970a203c3d11":{"text":"Yes, I wrote a short story for school.","id":"970a203c3d11","source":"BTS 15 · #69"},"e588b0c783e5":{"text":"It was about a girl who found a magical forest.","id":"e588b0c783e5","source":"BTS 15 · #71"},"7540b8da2dc8":{"id":"7540b8da2dc8","source":"SIU Advance 3 · #43","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/32bc01d9-e144-41b0-bb90-d51ddbc427ef.webp","imageBytes":57818},"f815c50f18b1":{"text":"Did your teacher like it?","id":"f815c50f18b1","source":"BTS 15 · #72"},"4d41262d81c3":{"text":"Yes, she gave me an A on the assignment.","id":"4d41262d81c3","source":"BTS 15 · #73"},"09c2c19a51f8":{"text":"Do you want to be a writer?","id":"09c2c19a51f8","source":"BTS 15 · #74"},"031b7c80c483":{"text":"Maybe, I think writing is fun.","id":"031b7c80c483","source":"BTS 15 · #75"},"24c6fe2446c1":{"text":"Good characters and an exciting plot are important.","id":"24c6fe2446c1","source":"BTS 15 · #77","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/2ae035e3-658b-40f1-a146-29fab8c89bd5.webp","imageBytes":19420},"3bab08e92aaa":{"text":"Should a story have a moral lesson?","id":"3bab08e92aaa","source":"BTS 15 · #78"},"0141d89bff91":{"text":"Not always, but some stories do have lessons.","id":"0141d89bff91","source":"BTS 15 · #79"},"e328add55544":{"text":"What is your favorite fairy tale?","id":"e328add55544","source":"BTS 15 · #80"},"2dba8d8f47a8":{"text":"I like Cinderella and Snow White.","id":"2dba8d8f47a8","source":"BTS 15 · #81","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/557443a5-90be-4c50-ab7f-bc5b7bd6447f.webp","imageBytes":12666},"7d738c3d9eff":{"text":"Are fairy tales based on true stories?","id":"7d738c3d9eff","source":"BTS 15 · #82"},"fa5e466c331b":{"text":"Some fairy tales may have been inspired by real events.","id":"fa5e466c331b","source":"BTS 15 · #83","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/fe314b21-5b94-4c9e-9784-ec3557dd839d.webp","imageBytes":52768},"325f216cbb4d":{"text":"Do you believe in fairy tales?","id":"325f216cbb4d","source":"BTS 15 · #84"},"4452f51b3d76":{"text":"Have you ever read a mystery novel?","id":"4452f51b3d76","source":"BTS 15 · #86"},"3246865e2ab7":{"text":"Yes, I like trying to guess who the criminal is.","id":"3246865e2ab7","source":"BTS 15 · #87","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/b85ccef0-d1d1-4e3c-aa0d-661f82e69c07.webp","imageBytes":15372},"bbb38b4991f5":{"text":"Can you usually solve the mystery before the end?","id":"bbb38b4991f5","source":"BTS 15 · #88"},"08346472c8b8":{"text":"Sometimes, but I am often surprised.","id":"08346472c8b8","source":"BTS 15 · #89"},"1d831da06f58":{"text":"What is the best mystery story you have read?","id":"1d831da06f58","source":"BTS 15 · #90"},"21d5117b8bed":{"text":"Sherlock Holmes stories are amazing.","id":"21d5117b8bed","source":"BTS 15 · #91","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/9fbffcae-db3e-44f0-bbd5-b98b4defbd07.webp","imageBytes":18224},"f9a759cf9aad":{"text":"Because the detective is very clever and logical.","id":"f9a759cf9aad","source":"BTS 15 · #93","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/22b80311-199f-4fff-8f30-8a6127bf2462.webp","imageBytes":12858},"6a3ea6b8ad5a":{"text":"Yes, I enjoy stories about exploration.","id":"6a3ea6b8ad5a","source":"BTS 15 · #95","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/af38b62b-bceb-4deb-89a6-d78ee8423e85.webp","imageBytes":17426},"751464d49950":{"text":"Danger, excitement, and interesting places are important.","id":"751464d49950","source":"BTS 15 · #97","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/c173a01c-ae6b-48bf-a2ee-c10eecf145ca.webp","imageBytes":40456},"db95c34b82b8":{"text":"Do you like stories with animals?","id":"db95c34b82b8","source":"BTS 15 · #98"},"d454e942b7b3":{"id":"d454e942b7b3","source":"SIU Advance 3 · #6","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/8d2740d9-9259-4ec6-b377-9d67867d6562.webp","imageBytes":14406},"a13c3b189d0f":{"text":"Yes, I enjoy stories about animals having adventures.","id":"a13c3b189d0f","source":"BTS 15 · #99","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/a7782f4a-fc1b-4860-a6d2-01293a9df418.webp","imageBytes":22178}}}
