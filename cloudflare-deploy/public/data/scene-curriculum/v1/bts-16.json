05e48.webp","imageBytes":11204},"e62169d23e61":{"text":"Why did you make that choice?","id":"e62169d23e61","source":"BTS 16 · #23"},"9660858bcd31":{"id":"9660858bcd31","source":"BTS 13 · #58","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/054328f4-00e2-44ec-b191-6352543e08ac.webp","imageBytes":7316},"3cd4591b316a":{"text":"Because pizza is my favorite food.","id":"3cd4591b316a","source":"BTS 16 · #24"},"cfb6f4e80887":{"id":"cfb6f4e80887","source":"BTS 6 · #100","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/edd32069-10a9-44f3-9990-f450b632e234.webp","imageBytes":14904},"2c3a13ea5db1":{"text":"Do you like making choices?","id":"2c3a13ea5db1","source":"BTS 16 · #25"},"95a50ba966ce":{"id":"95a50ba966ce","source":"BTS 15 · #51","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/7439d8f6-4e5d-4251-81db-ad5fd87e4e68.webp","imageBytes":12944},"f0177105a3ac":{"text":"Yes, but sometimes it is difficult.","id":"f0177105a3ac","source":"BTS 16 · #26"},"a0204aa878d4":{"text":"What was the hardest choice you ever made?","id":"a0204aa878d4","source":"BTS 16 · #27"},"72bb561a5b02":{"text":"Choosing between two colleges was very difficult.","id":"72bb561a5b02","source":"BTS 16 · #28","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/f3aab42a-5b08-49a3-aa70-256b0a5b15a9.webp","imageBytes":32338},"755a200abf20":{"text":"Did you regret your choice?","id":"755a200abf20","source":"BTS 16 · #29"},"c9b9dc864e43":{"text":"No, I am happy with my decision.","id":"c9b9dc864e43","source":"BTS 16 · #30"},"eb54145d58bd":{"text":"How do you make important decisions?","id":"eb54145d58bd","source":"BTS 16 · #31"},"835b2690cf77":{"text":"I think about the pros and cons carefully.","id":"835b2690cf77","source":"BTS 16 · #32","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/c07fe4e7-b0db-47e7-b34e-fa9086f1c437.webp","imageBytes":13650},"95f060e55760":{"id":"95f060e55760","source":"BTS 11 · #32","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/27ef3927-c677-41bb-8813-79ed1a600ef3.webp","imageBytes":9814},"d12f486abf8a":{"text":"Do you ask other people for advice?","id":"d12f486abf8a","source":"BTS 16 · #33"},"ec39fb2b952a":{"id":"ec39fb2b952a","source":"BTS 8 · #33","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/7267099f-6189-4db4-a348-a97780c4d204.webp","imageBytes":18020},"7ef8e12b497e":{"text":"What would you invent if you could?","id":"7ef8e12b497e","source":"BTS 16 · #35"},"294571c0a60c":{"text":"I would invent a time machine.","id":"294571c0a60c","source":"BTS 16 · #36","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/c9638498-5134-4cb3-86f9-ea824544e401.webp","imageBytes":10394},"526dbbd92ff5":{"id":"526dbbd92ff5","source":"BTS 10 · #88","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/dca4da8e-0677-40cf-9b12-3dd9b1ba7cff.webp","imageBytes":6788},"e42b05cd71ee":{"text":"I would go back and visit my younger self.","id":"e42b05cd71ee","source":"BTS 16 · #38"},"c9e79eac534e":{"id":"c9e79eac534e","source":"SIU Advance 2 · #8","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/e6d76a19-de58-4233-97cd-78dbcd1d9267.webp","imageBytes":19660},"dbb701917094":{"text":"Who invented the computer?","id":"dbb701917094","source":"BTS 16 · #39"},"b7de2c12be8a":{"text":"Several people contributed to inventing the computer.","id":"b7de2c12be8a","source":"BTS 16 · #40","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/8847411a-48de-41d5-a886-53b8120d185c.webp","imageBytes":21548},"2f59c2617f91":{"text":"How has technology changed our lives?","id":"2f59c2617f91","source":"BTS 16 · #43"},"a77095bc2dca":{"text":"Technology has made everything faster and easier.","id":"a77095bc2dca","source":"BTS 16 · #44"},"9257e495fa4c":{"text":"I think the internet is the best invention.","id":"9257e495fa4c","source":"BTS 16 · #46"},"4dda6cd1323b":{"text":"What would happen without the internet?","id":"4dda6cd1323b","source":"BTS 16 · #47"},"461799364929":{"text":"We would have to go back to using libraries and phones.","id":"461799364929","source":"BTS 16 · #48","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/554accdb-6158-48b3-b34b-6391b75605a6.webp","imageBytes":25868},"d53f981534e3":{"id":"d53f981534e3","source":"BTS 18 · #17","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/1c89688c-407f-453d-8bba-87f0d6df4b30.webp","imageBytes":14604},"6c656168e1a5":{"id":"6c656168e1a5","source":"SIU Basic 3 · #43","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/e901ca1a-54ba-48a8-b5a3-0ce3adad9f9c.webp","imageBytes":18360,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/3f65bf67-41c1-49f8-8d2f-9fa3424dbc18.mp4","videoBytes":111852,"duration":5.875},"68ef248337cd":{"text":"Yes, I use it for school and entertainment.","id":"68ef248337cd","source":"BTS 16 · #50"},"3f94cb864aed":{"text":"What inventions do you think we still need?","id":"3f94cb864aed","source":"BTS 16 · #51"},"69e392dbc035":{"id":"69e392dbc035","source":"BTS 20 · #33","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/ae0af793-e44b-422c-8298-bc24b5148083.webp","imageBytes":10960},"9bbdfe1ed882":{"text":"We need a cure for all diseases.","id":"9bbdfe1ed882","source":"BTS 16 · #52","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/4488723f-0874-4a4e-bdd2-e82f0829f4d7.webp","imageBytes":17538},"5ffcb3166b77":{"text":"Would you like to be an inventor?","id":"5ffcb3166b77","source":"BTS 16 · #53"},"2b651ea01a40":{"text":"Yes, I think inventing things would be fun.","id":"2b651ea01a40","source":"BTS 16 · #54"},"10c47089947b":{"text":"What qualities do inventors need?","id":"10c47089947b","source":"BTS 16 · #55","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/2e338bc9-f19f-4501-a198-d9995130606e.webp","imageBytes":22990},"3abcce4c4e83":{"text":"Creativity, patience, and persistence are important.","id":"3abcce4c4e83","source":"BTS 16 · #56","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/1ec8a3d2-229b-4cb6-9b08-789a22fc7c40.webp","imageBytes":34186},"fca25b40c496":{"text":"Can anyone become an inventor?","id":"fca25b40c496","source":"BTS 16 · #57"},"6a3cde200e9c":{"text":"Yes, if they work hard and believe in themselves.","id":"6a3cde200e9c","source":"BTS 16 · #58"},"2bfae4042bbc":{"id":"2bfae4042bbc","source":"BTS 7 · #80","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/18956d69-670b-45c6-b965-851c6090d308.webp","imageBytes":12494},"c7dbcebb6514":{"text":"Do you promise to be honest?","id":"c7dbcebb6514","source":"BTS 16 · #59"},"babd2b410d46":{"text":"Yes, honesty is very important to me.","id":"babd2b410d46","source":"BTS 16 · #60"},"186fbc7230ee":{"text":"Why is keeping promises important?","id":"186fbc7230ee","source":"BTS 16 · #61"},"360d20f5fdc8":{"text":"Because it shows respect and builds trust.","id":"360d20f5fdc8","source":"BTS 16 · #62"},"621612a8021d":{"text":"Have you ever broken a promise?","id":"621612a8021d","source":"BTS 16 · #63"},"e2cfafe984b0":{"text":"Yes, and I felt terrible about it.","id":"e2cfafe984b0","source":"BTS 16 · #64","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/94d0353d-bef7-4218-916c-161c50ff0808.webp","imageBytes":10898},"63cf300b3350":{"text":"I apologized and made a new promise.","id":"63cf300b3350","source":"BTS 16 · #66"},"61cbfa7d1561":{"text":"I try my best, but it can be difficult.","id":"61cbfa7d1561","source":"BTS 16 · #68"},"67f65a7bfe29":{"id":"67f65a7bfe29","source":"SIU Advance 1 · #69","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/b25cd91f-4714-41fe-968a-cf53ec83dd2f.webp","imageBytes":8684},"8334364f8d19":{"text":"I promise to be more patient with others.","id":"8334364f8d19","source":"BTS 16 · #70"},"90296d291db5":{"text":"I will practice being calm and understanding.","id":"90296d291db5","source":"BTS 16 · #72"},"803fe3a384d0":{"id":"803fe3a384d0","source":"BTS 3 · #83","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/46d06827-9460-4c31-bc85-f839c780f467.webp","imageBytes":16008},"c111e67d60ec":{"text":"Yes, my parents are very reliable.","id":"c111e67d60ec","source":"BTS 16 · #74","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/feb3317a-3bcd-4918-a69d-f4509045ac5f.webp","imageBytes":21154},"0c3fac38806a":{"text":"They promised to support my dreams.","id":"0c3fac38806a","source":"BTS 16 · #76"},"6b19c86483c9":{"id":"6b19c86483c9","source":"BTS 13 · #48","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/cd8c1f40-a223-442b-96cc-a37d161928b4.webp","imageBytes":19560},"5381e041b039":{"id":"5381e041b039","source":"BTS 17 · #19","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/2cb2c052-b5a6-4484-aa9e-3fe5ca9fca68.webp","imageBytes":8832},"9547e62e4261":{"text":"What would you do if a friend broke a promise?","id":"9547e62e4261","source":"BTS 16 · #79"},"c94053c6a126":{"text":"Would you forgive them?","id":"c94053c6a126","source":"BTS 16 · #81","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/66e6881d-5f03-45c4-b5c6-475fe2af0335.webp","imageBytes":13596},"98862bd1462e":{"text":"Yes, as long as they apologize sincerely.","id":"98862bd1462e","source":"BTS 16 · #82","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/f70548fa-3eb8-4012-bf99-656dea5e4b00.webp","imageBytes":21276},"676ae1155c61":{"text":"Is it always wrong to break a promise?","id":"676ae1155c61","source":"BTS 16 · #83","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/4132fdf7-44ee-415e-bef5-671bd45f5b3b.webp","imageBytes":19494},"8f61b8439636":{"text":"Not always, but you should have a good reason.","id":"8f61b8439636","source":"BTS 16 · #84"},"31e2c8ac0270":{"text":"What is a white lie?","id":"31e2c8ac0270","source":"BTS 16 · #85"},"43c3ab80f2c6":{"text":"A white lie is a small untruth told to avoid hurting someone.","id":"43c3ab80f2c6","source":"BTS 16 · #86","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/4132fdf7-44ee-415e-bef5-671bd45f5b3b.webp","imageBytes":19494},"94b25f15d687":{"text":"Is it okay to tell a white lie?","id":"94b25f15d687","source":"BTS 16 · #87"},"20411113e2d9":{"text":"I think it is usually better to be honest.","id":"20411113e2d9","source":"BTS 16 · #88"},"6c17c54d6545":{"text":"How do you choose between two options?","id":"6c17c54d6545","source":"BTS 16 · #89"},"de55a66be3ef":{"text":"I list the advantages and disadvantages of each.","id":"de55a66be3ef","source":"BTS 16 · #90","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/ae43422b-a8b0-4d92-983d-382a59c2f61f.webp","imageBytes":16360},"f53f38e6ad6a":{"text":"Do you ever flip a coin to decide?","id":"f53f38e6ad6a","source":"BTS 16 · #91","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/39bb8e7f-7ffc-4c1e-98c7-46004359f067.webp","imageBytes":19668},"d1115184c22a":{"text":"What would you choose if you could have anything?","id":"d1115184c22a","source":"BTS 16 · #93"},"cb2b718f8e44":{"text":"I would choose happiness and good health.","id":"cb2b718f8e44","source":"BTS 16 · #94"},"65ef87464053":{"text":"Is money the most important thing?","id":"65ef87464053","source":"BTS 16 · #95"},"8b496cd47fa1":{"text":"What choice would change your life?","id":"8b496cd47fa1","source":"BTS 16 · #97"},"5c8180243585":{"id":"5c8180243585","source":"SIU Advance 1 · #55","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/c18b9465-9012-4f0d-91dc-bbfd6536e365.webp","imageBytes":15982},"367a02ae53c0":{"text":"Choosing the right career would be life-changing.","id":"367a02ae53c0","source":"BTS 16 · #98"},"dd65ad8f907b":{"text":"Have you made any important life choices yet?","id":"dd65ad8f907b","source":"BTS 16 · #99"},"cc6f5136e4b7":{"text":"Not yet, but I know I will have to soon.","id":"cc6f5136e4b7","source":"BTS 16 · #100"}}}
