loudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/55491f9c-9048-40dc-95dc-88e9cf5aa778.webp","imageBytes":24948},"3502d9f85148":{"text":"The vegetables are fresh and crispy.","id":"3502d9f85148","source":"BTS 20 · #37"},"66f762e4c4fd":{"text":"This steak is tough and hard to cut.","id":"66f762e4c4fd","source":"BTS 20 · #38","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/6771ab1f-02d9-4f0d-8432-beccd68fadd3.webp","imageBytes":43282},"2bfae4042bbc":{"id":"2bfae4042bbc","source":"BTS 7 · #80","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/18956d69-670b-45c6-b965-851c6090d308.webp","imageBytes":12494},"e89820441e53":{"text":"I would like a well-done steak next time.","id":"e89820441e53","source":"BTS 20 · #39"},"a69d55366a21":{"id":"a69d55366a21","source":"BTS 5 · #96","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/0e3c6c1b-b734-4162-bf0a-259df548edfb.webp","imageBytes":14936},"436cad7d7102":{"text":"Sure, we can make it mild for you.","id":"436cad7d7102","source":"BTS 20 · #41"},"df4862c838bd":{"text":"Do you have any vegetarian options?","id":"df4862c838bd","source":"BTS 20 · #42"},"6ebbbf41c314":{"text":"Yes, we have several vegetarian dishes.","id":"6ebbbf41c314","source":"BTS 20 · #43"},"60c342064f55":{"id":"60c342064f55","source":"BTS 3 · #87","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/2b4b904a-2fb5-4bf2-862d-36d552359bb9.webp","imageBytes":9932},"7b8e0d2bb284":{"text":"What appetizers do you recommend?","id":"7b8e0d2bb284","source":"BTS 20 · #44"},"1bfc04fd0c21":{"text":"I recommend the shrimp tempura and spring rolls.","id":"1bfc04fd0c21","source":"BTS 20 · #45","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/98e287f0-a37e-4a1a-9298-81b374c58d69.webp","imageBytes":20246},"5097869abd6a":{"text":"Is there a chef's special today?","id":"5097869abd6a","source":"BTS 20 · #46","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/f651f321-5adc-4299-bb92-775ff9f768c4.webp","imageBytes":19316},"9e4391a9c052":{"text":"Yes, we have a special seafood pasta.","id":"9e4391a9c052","source":"BTS 20 · #47","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/de34e50a-e034-419b-8915-89ef91e3ba67.webp","imageBytes":29026},"855f982f8061":{"text":"Can I get extra sauce on the side?","id":"855f982f8061","source":"BTS 20 · #48"},"ffec533047f9":{"text":"Of course, I'll bring it right away.","id":"ffec533047f9","source":"BTS 20 · #49"},"a258a2fbb0ec":{"id":"a258a2fbb0ec","source":"BTS 27 · #13","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/29505e03-2a2c-4311-a0dd-491343174862.webp","imageBytes":12072},"035d629be859":{"text":"This bread is delicious and warm.","id":"035d629be859","source":"BTS 20 · #50"},"b0fd1d117139":{"text":"Would you like butter for your bread?","id":"b0fd1d117139","source":"BTS 20 · #51"},"28eca846a993":{"text":"Yes, please. Butter and jam, please.","id":"28eca846a993","source":"BTS 20 · #52"},"cc1b5cda6058":{"text":"The coffee is too bitter.","id":"cc1b5cda6058","source":"BTS 20 · #53","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/f9129339-b4cf-40cb-9405-8ab801a48838.webp","imageBytes":9280},"309835fdd5f8":{"text":"Would you like some cream or sugar?","id":"309835fdd5f8","source":"BTS 20 · #54"},"ed62dacb8a57":{"text":"Yes, please add some sugar.","id":"ed62dacb8a57","source":"BTS 20 · #55"},"acc0558ed5ca":{"text":"What drinks do you have available?","id":"acc0558ed5ca","source":"BTS 20 · #56","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/c8c50751-61ea-49b6-97ac-a38e003f94c5.webp","imageBytes":10920},"d4be2e44b693":{"text":"We have sodas, juices, water, and tea.","id":"d4be2e44b693","source":"BTS 20 · #57","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/f08594e1-792c-4fcb-adb9-6b2aa8f2a827.webp","imageBytes":19578},"339170c409b5":{"text":"I'll have an iced tea, please.","id":"339170c409b5","source":"BTS 20 · #58","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/4b056ade-261b-4a8b-bcbe-11c2068fd5fd.webp","imageBytes":8234},"7fe2bf4a7d56":{"text":"Do you serve alcohol at this restaurant?","id":"7fe2bf4a7d56","source":"BTS 20 · #59","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/42ae0ec3-8a54-4a97-9412-7a2c7584162a.webp","imageBytes":17468},"a3d18258a8bd":{"text":"Yes, we have beer, wine, and cocktails.","id":"a3d18258a8bd","source":"BTS 20 · #60","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/7eee1b0b-a07d-4f7e-97a5-2b61b00a2482.webp","imageBytes":10084},"b700f97e5100":{"id":"b700f97e5100","source":"BTS 5 · #62","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/f7877065-b30b-4a66-851f-7cb78d36eb6a.webp","imageBytes":27682},"641b2a8e6185":{"text":"Can I see the wine list?","id":"641b2a8e6185","source":"BTS 20 · #61"},"503e53e59b18":{"text":"Sure, here is our wine selection.","id":"503e53e59b18","source":"BTS 20 · #62","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/5e5403c4-97d3-4578-b927-978c560702fe.webp","imageBytes":19118},"7925648b90c6":{"text":"What is the house wine?","id":"7925648b90c6","source":"BTS 20 · #63"},"faa5d5302fb3":{"text":"The house wine is from California.","id":"faa5d5302fb3","source":"BTS 20 · #64","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/e1409585-7d95-4dac-8deb-429bf1188cd4.webp","imageBytes":18530},"a9130ecf9f02":{"text":"This pizza is delicious! Who made it?","id":"a9130ecf9f02","source":"BTS 20 · #65"},"8c803c07c22f":{"text":"Our chef made it fresh from scratch.","id":"8c803c07c22f","source":"BTS 20 · #66","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/0c3b72dc-4359-4cc4-832f-e967715b488c.webp","imageBytes":20612},"c8a18977c07e":{"text":"Do you deliver food to homes?","id":"c8a18977c07e","source":"BTS 20 · #67"},"d1c69a11ec10":{"text":"Yes, we deliver within a five-mile radius.","id":"d1c69a11ec10","source":"BTS 20 · #68"},"6184529f95a5":{"text":"How long does delivery usually take?","id":"6184529f95a5","source":"BTS 20 · #69"},"263057836e98":{"text":"Delivery takes about thirty minutes.","id":"263057836e98","source":"BTS 20 · #70"},"0a29f66abf66":{"text":"Can I place an order for takeout?","id":"0a29f66abf66","source":"BTS 20 · #71","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/f0999299-480c-4d60-b94c-884f73a42522.webp","imageBytes":8554},"8ccdf8444d4c":{"text":"Yes, you can order online or by phone.","id":"8ccdf8444d4c","source":"BTS 20 · #72"},"583564c6e3ae":{"text":"What time does the restaurant close?","id":"583564c6e3ae","source":"BTS 20 · #73"},"b3fa408aa636":{"text":"We close at ten o'clock tonight.","id":"b3fa408aa636","source":"BTS 20 · #74","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/64884e7f-2dca-4c9e-a26a-6d652d90ea86.webp","imageBytes":11226},"a218845f562a":{"text":"Do you accept credit cards?","id":"a218845f562a","source":"BTS 20 · #75"},"88cf5b4637c8":{"text":"Yes, we accept all major credit cards.","id":"88cf5b4637c8","source":"BTS 20 · #76"},"6086db984a5f":{"text":"Yes, how many people will be dining?","id":"6086db984a5f","source":"BTS 20 · #78","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/c763bb32-bf02-47d3-bd10-7f7a776a68f4.webp","imageBytes":27634},"155b2fcacaf0":{"text":"We have a table for four people.","id":"155b2fcacaf0","source":"BTS 20 · #79"},"0050c6524d74":{"text":"Do you have a dress code?","id":"0050c6524d74","source":"BTS 20 · #82"},"32b75e805da2":{"text":"Smart casual is appropriate for this restaurant.","id":"32b75e805da2","source":"BTS 20 · #83"},"b9af8f3cf474":{"text":"Is there a kids menu?","id":"b9af8f3cf474","