lj6afu2oFQqivYqvn7k/5a30b321-3bd9-4e80-829c-317f4ef56233.webp","imageBytes":16336},"629f2df205f8":{"text":"Christmas is celebrated by many people worldwide.","id":"629f2df205f8","source":"BTS 21 · #37"},"8d63023fd450":{"text":"It is a time for family and giving.","id":"8d63023fd450","source":"BTS 21 · #38"},"7c339771851a":{"text":"Do you hang stockings by the fireplace?","id":"7c339771851a","source":"BTS 21 · #39","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/62c396b1-9217-4a20-87cc-24ffce09ed92.webp","imageBytes":11140},"70f3aae8d440":{"text":"Yes, and we fill them with small gifts.","id":"70f3aae8d440","source":"BTS 21 · #40"},"ccea702369fa":{"text":"What about Hanukkah?","id":"ccea702369fa","source":"BTS 21 · #41","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/54c006c7-c280-49d1-a8dd-084a00436cf5.webp","imageBytes":11700},"0de430fc7f35":{"text":"It is a Jewish holiday celebrated for eight days.","id":"0de430fc7f35","source":"BTS 21 · #42","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/88b89108-9a29-43a0-90bf-de6fd73c8778.webp","imageBytes":21374},"54ce956f7ef7":{"text":"Do you light candles during Hanukkah?","id":"54ce956f7ef7","source":"BTS 21 · #43"},"9e927386fdb0":{"text":"Yes, we light one candle each night.","id":"9e927386fdb0","source":"BTS 21 · #44"},"21d5a6942e79":{"text":"What is Diwali?","id":"21d5a6942e79","source":"BTS 21 · #45","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/1b5d420c-a0e3-40c8-b5a6-40b8bab96d81.webp","imageBytes":17284},"05ca8efc4444":{"text":"It is the festival of lights in India.","id":"05ca8efc4444","source":"BTS 21 · #46"},"245a8fa1e5f9":{"text":"Do you light lamps for Diwali?","id":"245a8fa1e5f9","source":"BTS 21 · #47"},"c8a4657cb26e":{"text":"Yes, lamps symbolize the victory of good.","id":"c8a4657cb26e","source":"BTS 21 · #48","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/2cacf79a-fd12-4ff1-bb60-97686f6ac501.webp","imageBytes":5814},"afc318aadede":{"text":"Eid is an important Islamic holiday.","id":"afc318aadede","source":"BTS 21 · #49","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/05129784-ad1e-4962-ba5f-a24e19f6be7d.webp","imageBytes":38300},"8807d59249dd":{"text":"It marks the end of Ramadan.","id":"8807d59249dd","source":"BTS 21 · #50","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/673120d1-9897-4e7f-843e-92c26b9ea618.webp","imageBytes":19244},"4669b458ca4e":{"text":"What is Lunar New Year?","id":"4669b458ca4e","source":"BTS 21 · #51"},"c9a997d39eaf":{"text":"It is celebrated in many Asian countries.","id":"c9a997d39eaf","source":"BTS 21 · #52"},"22521962d366":{"text":"Do you wear new clothes for Lunar New Year?","id":"22521962d366","source":"BTS 21 · #53"},"c85c96fe5397":{"text":"Yes, new clothes bring good luck.","id":"c85c96fe5397","source":"BTS 21 · #54","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/2eadd77d-c790-4533-8bd3-1e4c326c86ea.webp","imageBytes":14308},"b3804d87829d":{"text":"What gifts do you exchange?","id":"b3804d87829d","source":"BTS 21 · #55"},"f6677f0d9a1c":{"text":"We give red envelopes with money inside.","id":"f6677f0d9a1c","source":"BTS 21 · #56","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/d690e4d9-766e-419d-be0c-39a22813d500.webp","imageBytes":16504},"e401b2584019":{"text":"Do you clean your house before holidays?","id":"e401b2584019","source":"BTS 21 · #57","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/9e036025-fa4f-4dfb-a7f0-dd934ac718bb.webp","imageBytes":9148},"0b1a789c07dd":{"text":"Yes, cleaning symbolizes a fresh start.","id":"0b1a789c07dd","source":"BTS 21 · #58","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/73fc26fd-89c0-4804-814f-f3c011470bf2.webp","imageBytes":19970},"d36987e823e1":{"text":"What traditional foods do you eat?","id":"d36987e823e1","source":"BTS 21 · #59"},"bec0835d69e2":{"text":"We eat dumplings and moon cakes.","id":"bec0835d69e2","source":"BTS 21 · #60","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/47de9731-6439-444c-b4ad-fddcb5d88a01.webp","imageBytes":18584},"f6df67e9870c":{"text":"Are there special decorations?","id":"f6df67e9870c","source":"BTS 21 · #61","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/ba2d7cfd-b43d-4696-aa1c-31399cfb041c.webp","imageBytes":76674},"526dbbd92ff5":{"id":"526dbbd92ff5","source":"BTS 10 · #88","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/dca4da8e-0677-40cf-9b12-3dd9b1ba7cff.webp","imageBytes":6788},"ace42c9609af":{"text":"Yes, we use red lanterns and banners.","id":"ace42c9609af","source":"BTS 21 · #62","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/3d7f4cd0-3d71-4603-bba7-a1b538177e56.webp","imageBytes":23502},"be1ef3741060":{"text":"It is a holiday to give thanks for the harvest.","id":"be1ef3741060","source":"BTS 21 · #64","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/458bb142-5284-4ff2-8e27-7a0a84a5a8ad.webp","imageBytes":55516},"1c77e8137580":{"text":"What traditional food is served?","id":"1c77e8137580","source":"BTS 21 · #65"},"7b5ee63fdaa5":{"text":"Turkey is the traditional Thanksgiving dish.","id":"7b5ee63fdaa5","source":"BTS 21 · #66","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/bf164866-5907-4683-9a97-fd558897e184.webp","imageBytes":34938},"82f0f1bf71b1":{"text":"What else do you serve?","id":"82f0f1bf71b1","source":"BTS 21 · #67"},"0a5b390e547d":{"text":"We serve stuffing, cranberry sauce, and pie.","id":"0a5b390e547d","source":"BTS 21 · #68","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/921c6b40-eca5-43fa-83ab-a88c52925897.webp","imageBytes":25152},"0d400574ea2d":{"text":"Do you travel for the holidays?","id":"0d400574ea2d","source":"BTS 21 · #69"},"1c59cde300a8":{"text":"Yes, I visit my relatives in another city.","id":"1c59cde300a8","source":"BTS 21 · #70"},"a0fac33d88da":{"text":"How long are your holiday vacations?","id":"a0fac33d88da","source":"BTS 21 · #71","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/fdf2b92b-1a0b-41b8-9142-a1ae2dff331a.webp","imageBytes":16300},"64a80b988138":{"text":"Usually about two weeks.","id":"64a80b988138","source":"BTS 21 · #72"},"f210de7fc36a":{"text":"What is your favorite holiday memory?","id":"f210de7fc36a","source":"BTS 21 · #73","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/c759115d-2d5e-41c8-8960-94a74b3045c7.webp","imageBytes":40360},"c42517e970f6":{"text":"I remember decorating the tree with my family.","id":"c42517e970f6","source":"BTS 21 · #74","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/2837e589-5ea1-423e-8752-c9fd76788ff9.webp","imageBytes":35688},"b050924f3d1f":{"id":"b050924f3d1f","source":"BTS 10 · #46","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/06dcf501-f3cf-4835-8444-abc635e05e48.webp","imageBytes":11204},"458e1feba108":{"text":"Do you make holiday decorations by hand?","id":"458e1feba108","source":"BTS 21 · #75"},"8ed117395284":{"text":"Yes, we make paper snowflakes together.","id":"8ed117395284","source":"BTS 21 · #76","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/2314d7af-9d50-40fb-a648-23eb92f9b6ca.webp","imageBytes":26420},"6dec745046c3":{"text":"What colors are traditional for Christmas?","id":"6dec745046c3","source":"BTS 21 · #77"},"fd97f95e375d":{"id":"fd97f95e375d","source":"BTS 2 · #11","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/bfab9d2d-66f9-4675-9371-4813c1b8609f.webp","imageBytes":14226,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/4cfd1592-4882-4f90-93ee-afb38273c499.mp4","videoBytes":150678,"duration":5.875},"30ced7e721c2":{"text":"Red, green, and gold are traditional colors.","id":"30ced7e721c2","source":"BTS 21 · #78","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/321feae6-a411-4fb7-acef-f975e65aa1ab.webp","imageBytes":53202},"594ac2a9e27d":{"text":"Do you sing holiday songs?","id":"594ac2a9e27d","source":"BTS 21 · #79"},"1fca5f979602":{"id":"1fca5f979602","source":"BTS 13 · #44","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/ec520d10-8911-4f80-8b80-c577554d627c.webp","imageBytes":16606},"f646db43c4a7":{"text":"Yes, we sing carols together as a family.","id":"f646db43c4a7","source":"BTS 21 · #80","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/2427b5e2-b135-4d48-a61b-9c5676be5f1d.webp","imageBytes":26088},"51219071b863":{"text":"What is a holiday tradition?","id":"51219071b863","source":"BTS 21 · #81","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/a3ab5e18-08df-4f6f-a33d-6690372c7590.webp","imageBytes":38188},"768b2b6192b0":{"text":"It is something you do the same way every year.","id":"768b2b6192b0","source":"BTS 21 · #82"},"324927d9c67c":{"text":"What traditions does your family have?","id":"324927d9c67c","source":"BTS 21 · #83"},"86889e4007ce":{"text":"We always go caroling on Christmas Eve.","id":"86889e4007ce","source":"BTS 21 · #84","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/13f2bfcf-6765-4b82-8904-68af7e105236.webp","imageBytes":14186},"0c282f03c2f7":{"text":"Do you attend religious services for holidays?","id":"0c282f03c2f7","source":"BTS 21 · #85"},"c03c65e85722":{"text":"Yes, we go to church on Christmas and Easter.","id":"c03c65e85722","source":"BTS 21 · #86","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/a759ae90-3c83-48bd-b674-12129cd28d67.webp","imageBytes":26520},"bf2813871b88":{"text":"What is Boxing Day?","id":"bf2813871b88","source":"BTS 21 · #87","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/0ee6f132-eeb4-4706-9b61-b5286df01267.webp","imageBytes":27246},"ef5f98d0ec3a":{"text":"Do you go shopping on Boxing Day?","id":"ef5f98d0ec3a","source":"BTS 21 · #89"},"78fc74be7028":{"text":"Yes, there are big sales and discounts.","id":"78fc74be7028","source":"BTS 21 · #90"},"95f060e55760":{"id":"95f060e55760","source":"BTS 11 · #32","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/27ef3927-c677-41bb-8813-79ed1a600ef3.webp","imageBytes":9814},"2f76dd4ca59a":{"text":"What about Summer solstice?","id":"2f76dd4ca59a","source":"BTS 21 · #91","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/919db967-aeab-4700-9d5d-ab6cce585cec.webp","imageBytes":23064},"51723caa18cc":{"text":"It is the longest day of the year.","id":"51723caa18cc","source":"BTS 21 · #92"},"7879986bef6f":{"text":"What festivals happen in summer?","id":"7879986bef6f","source":"BTS 21 · #93"},"24157b4097d6":{"text":"There are many outdoor concerts and fairs.","id":"24157b4097d6","source":"BTS 21 · #94"},"8e305481fca8":{"text":"Yes, I love the local community festivals.","id":"8e305481fca8","source":"BTS 21 · #96"},"cd11cfa5ee58":{"id":"cd11cfa5ee58","source":"SIU Advance 2 · #25","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/69560c09-040a-4279-9ada-152aa398ab00.webp","imageBytes":21376},"a36a6c1709af":{"text":"What about Winter solstice?","id":"a36a6c1709af","source":"BTS 21 · #97"},"1b275fcb0e19":{"text":"It is the shortest day of the year.","id":"1b275fcb0e19","source":"BTS 21 · #98"},"028dfaa1ba8d":{"text":"Yes, some cultures have special festivals.","id":"028dfaa1ba8d","source":"BTS 21 · #100"}}}
