845ae-2836-49d4-b4c7-6bbd8c311461.webp","imageBytes":20380},"c1882890d0a9":{"id":"c1882890d0a9","source":"BTS 7 · #13","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/cb716f9b-38e4-459e-a025-e70a1e5009c0.webp","imageBytes":12830},"b96e9f7b43c7":{"text":"How long does a cold usually last?","id":"b96e9f7b43c7","source":"BTS 22 · #33"},"da5232003d5e":{"text":"Usually about one to two weeks.","id":"da5232003d5e","source":"BTS 22 · #34"},"4e145c357962":{"text":"What medicine helps with a cold?","id":"4e145c357962","source":"BTS 22 · #35"},"b1c80b1044e4":{"text":"Vitamin C and rest help fight a cold.","id":"b1c80b1044e4","source":"BTS 22 · #36","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/8ea34be7-a695-47e8-80bc-dfa1cae06000.webp","imageBytes":13352},"30ab63bd8e04":{"id":"30ab63bd8e04","source":"BTS 10 · #54","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/e8f41a88-9376-4587-8eff-b257f7a7e8ad.webp","imageBytes":23518},"765f9b599255":{"text":"Have you ever broken a bone?","id":"765f9b599255","source":"BTS 22 · #37"},"196858914205":{"text":"Yes, I broke my arm when I was younger.","id":"196858914205","source":"BTS 22 · #38"},"c9e79eac534e":{"id":"c9e79eac534e","source":"SIU Advance 2 · #8","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/e6d76a19-de58-4233-97cd-78dbcd1d9267.webp","imageBytes":19660},"beb72242d813":{"text":"Did you need to wear a cast?","id":"beb72242d813","source":"BTS 22 · #39"},"f34d6f481338":{"text":"Yes, I wore a cast for six weeks.","id":"f34d6f481338","source":"BTS 22 · #40","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/9b72ea80-618b-467d-90b7-66707aefb86a.webp","imageBytes":5078},"8ae356d4a8c6":{"text":"What is a balanced diet?","id":"8ae356d4a8c6","source":"BTS 22 · #41"},"cb1889b1be65":{"text":"It includes proteins, carbs, fruits, and vegetables.","id":"cb1889b1be65","source":"BTS 22 · #42","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/0d091ca8-5df8-444f-9fdd-d094475d8ab8.webp","imageBytes":21328},"0e3852aa45d7":{"text":"Is it healthy to skip breakfast?","id":"0e3852aa45d7","source":"BTS 22 · #45"},"1a12f0a6cd76":{"id":"1a12f0a6cd76","source":"BTS 4 · #10","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/1fdcf23f-6237-48c6-ae21-a77be319b9e1.webp","imageBytes":10896,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/6342dea8-ad97-48ba-8640-1a8437c6a5e1.mp4","videoBytes":235390,"duration":5.875},"0160f3db4310":{"text":"No, breakfast is an important meal.","id":"0160f3db4310","source":"BTS 22 · #46"},"a9aed7840058":{"text":"What are healthy snacks?","id":"a9aed7840058","source":"BTS 22 · #47"},"5003aa19a98f":{"text":"Nuts, yogurt, and fruit are healthy snacks.","id":"5003aa19a98f","source":"BTS 22 · #48","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/9d5a1bec-8b60-4fc8-9b1e-ff9fbd26f14e.webp","imageBytes":21304},"afa21629a7c7":{"text":"How much exercise is recommended?","id":"afa21629a7c7","source":"BTS 22 · #49"},"626a7fade78b":{"text":"At least thirty minutes daily is good.","id":"626a7fade78b","source":"BTS 22 · #50"},"1b77a5322abf":{"text":"What are the benefits of exercise?","id":"1b77a5322abf","source":"BTS 22 · #51"},"0b12a91c190d":{"text":"It strengthens your heart and muscles.","id":"0b12a91c190d","source":"BTS 22 · #52","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/9063bcc9-3327-4021-8e7a-ba96e2526799.webp","imageBytes":13142},"785e962b1e86":{"text":"Does stress affect your health?","id":"785e962b1e86","source":"BTS 22 · #53"},"0ae7524c699d":{"text":"Yes, stress can cause many health problems.","id":"0ae7524c699d","source":"BTS 22 · #54"},"07f1f9225ba4":{"text":"How do you manage stress?","id":"07f1f9225ba4","source":"BTS 22 · #55","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/5162178a-326e-47ad-a05e-683faf911c46.webp","imageBytes":12518},"788ca85a8b26":{"text":"I meditate and spend time in nature.","id":"788ca85a8b26","source":"BTS 22 · #56"},"8a82fabbae61":{"text":"What is good posture?","id":"8a82fabbae61","source":"BTS 22 · #57"},"d3c7109d9584":{"text":"Keeping your back straight when sitting.","id":"d3c7109d9584","source":"BTS 22 · #58","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/d2069616-5d0e-49d0-80dc-6ae261b49324.webp","imageBytes":16940},"f18be819fcad":{"text":"Good posture prevents back pain.","id":"f18be819fcad","source":"BTS 22 · #60"},"f1b2367999ce":{"id":"f1b2367999ce","source":"BTS 3 · #43","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/5805580f-1c2a-466e-9050-38588b7e94e5.webp","imageBytes":22980},"1f34c0426295":{"text":"Do you wear glasses or contacts?","id":"1f34c0426295","source":"BTS 22 · #61","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/b3375e68-a0cd-44aa-93e8-c6ea5d872d48.webp","imageBytes":11776},"ac5020c19fe2":{"text":"Yes, I need glasses to see clearly.","id":"ac5020c19fe2","source":"BTS 22 · #62"},"f21c0cf3d5f7":{"text":"How often should you see a dentist?","id":"f21c0cf3d5f7","source":"BTS 22 · #63"},"c8c15d1bc122":{"text":"You should go twice a year.","id":"c8c15d1bc122","source":"BTS 22 · #64","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/5a609d5d-5fe6-414f-bce6-2056d00535f6.webp","imageBytes":37418},"a69d55366a21":{"id":"a69d55366a21","source":"BTS 5 · #96","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/0e3c6c1b-b734-4162-bf0a-259df548edfb.webp","imageBytes":14936},"a782e5b8c52f":{"text":"Yes, I floss every evening.","id":"a782e5b8c52f","source":"BTS 22 · #66","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/7a56658d-a066-4bfc-aa25-6b5ed9ca6a19.webp","imageBytes":7634},"2083c73e6aa5":{"text":"What causes tooth decay?","id":"2083c73e6aa5","source":"BTS 22 · #67","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/af902030-ed5d-4423-bf43-c1e4b72442a5.webp","imageBytes":11920},"b66058b7d2f3":{"text":"Sugar and lack of brushing cause decay.","id":"b66058b7d2f3","source":"BTS 22 · #68","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/6d8b25af-3c3b-4056-935a-aaaba7c5cc4a.webp","imageBytes":22172},"c6963c55ccb0":{"text":"Limited amounts are best for health.","id":"c6963c55ccb0","source":"BTS 22 · #70"},"53232f98a8ee":{"text":"What are the effects of smoking?","id":"53232f98a8ee","source":"BTS 22 · #71"},"daa3bf6dee05":{"text":"Smoking damages your lungs and heart.","id":"daa3bf6dee05","source":"BTS 22 · #72","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/b25cd91f-4714-41fe-968a-cf53ec83dd2f.webp","imageBytes":8684},"74871eb62e03":{"text":"Do you exercise your brain?","id":"74871eb62e03","source":"BTS 22 · #73"},"6ff07979fbaa":{"text":"Yes, reading and puzzles keep it active.","id":"6ff07979fbaa","source":"BTS 22 · #74","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/d1a7e8c2-5a76-40bd-b090-0016412974ea.webp","imageBytes":21754},"154be1b651b0":{"text":"Morning or evening both work well.","id":"154be1b651b0","source":"BTS 22 · #76"},"b3c0fabfb06f":{"text":"Should you eat before exercising?","id":"b3c0fabfb06f","source":"BTS 22 · #77"},"e1dce1a04b7a":{"text":"Eat a light snack about an hour before.","id":"e1dce1a04b7a","source":"BTS 22 · #78","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/f7b85f7d-4380-4944-a2ae-f92a1be290bc.webp","imageBytes":12292},"b6ad3e6edce2":{"text":"How important is stretching?","id":"b6ad3e6edce2","source":"BTS 22 · #79","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/0784b98a-e81e-4b13-92e6-9ccbc62b856f.webp","imageBytes":8902},"e02952b3b901":{"text":"It prevents injuries and improves flexibility.","id":"e02952b3b901","source":"BTS 22 · #80","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/08bdbf06-7f38-447a-addb-8acf8ad29033.webp","imageBytes":18528},"f0cff32f58a3":{"text":"What is a typical workout routine?","id":"f0cff32f58a3","source":"BTS 22 · #81","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/ad90185c-a114-46c7-8695-9d0a41956787.webp","imageBytes":10948},"4c030a1649a8":{"text":"Warm up, exercise, and cool down.","id":"4c030a1649a8","source":"BTS 22 · #82"},"e268436f23a4":{"text":"Do you take vitamins?","id":"e268436f23a4","source":"BTS 22 · #83","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/6962cc6e-3774-444f-8fae-85a57450bf95.webp","imageBytes":15474},"d1c2eb14de78":{"text":"Yes, I take a multivitamin daily.","id":"d1c2eb14de78","source":"BTS 22 · #84","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/7a4c6ae8-d60f-4fd6-bc0d-e350132a49f9.webp","imageBytes":8286},"8eaf66c14032":{"text":"What vitamin D does for your body?","id":"8eaf66c14032","source":"BTS 22 · #85"},"475a7846f42b":{"text":"It keeps bones strong and healthy.","id":"475a7846f42b","source":"BTS 22 · #86","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/ec48639f-7ac3-445e-9217-b10196c8afcf.webp","imageBytes":18608},"cc1747ad16dc":{"text":"Is organic food better for you?","id":"cc1747ad16dc","source":"BTS 22 · #87","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/e3e818d5-ebf8-4e7a-9e4d-704f916b6080.webp","imageBytes":60848},"dd3806c03721":{"text":"It can be, as it has fewer chemicals.","id":"dd3806c03721","source":"BTS 22 · #88","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/e244b5ea-f1f7-44b8-a620-ef5079f71636.webp","imageBytes":26416},"7359e32a3e83":{"text":"What is food poisoning?","id":"7359e32a3e83","source":"BTS 22 · #89","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/b3f017cb-4856-4912-849a-84ff31975a59.webp","imageBytes":13510},"28ef192a7b61":{"text":"It is an illness from eating bad food.","id":"28ef192a7b61","source":"BTS 22 · #90"},"cb04071d423e":{"text":"What are signs of the flu?","id":"cb04071d423e","source":"BTS 22 · #91","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/ce52be54-95a4-4032-9de5-9346e713d666.webp","imageBytes":22758},"0e11334431a4":{"text":"Fever, body aches, and fatigue.","id":"0e11334431a4","source":"BTS 22 · #92","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/b25cd91f-4714-41fe-968a-cf53ec83dd2f.webp","imageBytes":8684},"5310a697e27c":{"text":"How do you prevent the flu?","id":"5310a697e27c","source":"BTS 22 · #93"},"b92f4ec8b496":{"text":"Get a flu shot before flu season.","id":"b92f4ec8b496","source":"BTS 22 · #94","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/c1b03ba6-6609-4f8b-9c8e-21683a1c1b5b.webp","imageBytes":14782},"cc6f4328bca7":{"text":"Rest and drink fluids.","id":"cc6f4328bca7","source":"BTS 22 · #96","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/5c03db78-9105-43c8-bfb0-104a4e2411e8.webp","imageBytes":11684},"68c9c652cc6f":{"text":"Do you have health insurance?","id":"68c9c652cc6f","source":"BTS 22 · #99","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/9379356f-7a73-4955-8e06-543eb3833247.webp","imageBytes":5646},"1c47f6cb555e":{"text":"Yes, it covers most medical expenses.","id":"1c47f6cb555e","source":"BTS 22 · #100","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/325ce30d-b13c-4565-9c3a-9d57fd1cf18c.webp","imageBytes":13612}}}
