6afu2oFQqivYqvn7k/317f89fd-cd7e-44d8-9859-183d323f600a.webp","imageBytes":16012,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/b011d0c0-b20e-4023-84d0-7a150821fd07.mp4","videoBytes":501386,"duration":5.875},"54a06d981ee9":{"text":"The news reporter said it will rain tomorrow.","id":"54a06d981ee9","source":"BTS 23 · #14","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/73854f95-b09f-4c85-b266-1d01e155ef28.webp","imageBytes":17556},"1d0c93458f48":{"text":"Did you watch the news today?","id":"1d0c93458f48","source":"BTS 23 · #5"},"f32304ce84e7":{"text":"Yes, I saw an interesting report about technology.","id":"f32304ce84e7","source":"BTS 23 · #6"},"df0a7f95ca88":{"text":"Some are interesting, but many are fake.","id":"df0a7f95ca88","source":"BTS 23 · #72","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/ceb2196e-bdc8-4ccd-8c3d-8df0be6f7faa.webp","imageBytes":23390},"266458571794":{"text":"What kind of TV shows do you like?","id":"266458571794","source":"BTS 23 · #7"},"8725f596b1a7":{"text":"I like comedy shows. They make me laugh.","id":"8725f596b1a7","source":"BTS 23 · #8","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/84804d2c-87a9-4eff-8a67-07a8ddd6730a.webp","imageBytes":5512,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/4ce5dd92-0b9c-4148-af36-2ea0cda02097.mp4","videoBytes":75840,"duration":5.875},"5a26f7c3c448":{"text":"How many hours of TV do you watch a day?","id":"5a26f7c3c448","source":"BTS 23 · #9"},"39738afd59f9":{"text":"I watch about one hour of TV a day.","id":"39738afd59f9","source":"BTS 23 · #10"},"fb16cbb51a01":{"text":"Do you skip commercials?","id":"fb16cbb51a01","source":"BTS 23 · #43","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/26790f78-aadf-45d2-824c-effd8f3c8e00.webp","imageBytes":44892},"c2cd1891468f":{"text":"Commercials try to make you buy things.","id":"c2cd1891468f","source":"BTS 23 · #11"},"d20d9e005ea8":{"text":"Do you believe everything you see on TV?","id":"d20d9e005ea8","source":"BTS 23 · #12"},"1db9bddbc91d":{"text":"No, you should think carefully about what you see.","id":"1db9bddbc91d","source":"BTS 23 · #13"},"915d868a2b56":{"text":"Have you ever been on TV?","id":"915d868a2b56","source":"BTS 23 · #15"},"0a51b3ecf2d4":{"text":"No, but I would like to be on a game show.","id":"0a51b3ecf2d4","source":"BTS 23 · #16"},"d4b4a2915ce6":{"text":"What makes a good advertisement?","id":"d4b4a2915ce6","source":"BTS 23 · #45","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/fbafe98a-51ec-4d2f-a6bf-adb200fb4f98.webp","imageBytes":30604},"143a0f4f3d44":{"text":"Too much TV is not good for your eyes.","id":"143a0f4f3d44","source":"BTS 23 · #17"},"b31ad8f1e5a5":{"text":"Reading a book is better than watching TV.","id":"b31ad8f1e5a5","source":"BTS 23 · #18"},"cd3aab53cba6":{"text":"What did you learn from the news today?","id":"cd3aab53cba6","source":"BTS 23 · #19"},"c13d87b89f46":{"text":"I learned about a new discovery in science.","id":"c13d87b89f46","source":"BTS 23 · #20"},"6c656168e1a5":{"id":"6c656168e1a5","source":"SIU Basic 3 · #43","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/e901ca1a-54ba-48a8-b5a3-0ce3adad9f9c.webp","imageBytes":18360,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/3f65bf67-41c1-49f8-8d2f-9fa3424dbc18.mp4","videoBytes":111852,"duration":5.875},"d960c76ba1f0":{"text":"I really enjoy watching crime dramas.","id":"d960c76ba1f0","source":"BTS 23 · #22","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/fdb18a87-a436-47eb-805c-046604a52375.webp","imageBytes":7740},"f029d07c8ed5":{"text":"Do you have a television in your bedroom?","id":"f029d07c8ed5","source":"BTS 23 · #23"},"69f867dc41e4":{"text":"Yes, but I don't watch it very often.","id":"69f867dc41e4","source":"BTS 23 · #24"},"6b1b8dc6a064":{"text":"How do you choose what to watch?","id":"6b1b8dc6a064","source":"BTS 23 · #25"},"dbb646e7b50c":{"text":"I check the TV guide or watch recommendations.","id":"dbb646e7b50c","source":"BTS 23 · #26"},"bfa0c5797dd0":{"text":"What time do you usually watch TV?","id":"bfa0c5797dd0","source":"BTS 23 · #27"},"0b16d6259152":{"text":"I watch in the evening after dinner.","id":"0b16d6259152","source":"BTS 23 · #28"},"fe7fce0d234b":{"id":"fe7fce0d234b","source":"SIU Basic 2 · #28","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/1d478d38-807e-4727-8e62-b03b99803489.webp","imageBytes":12944,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/3d02ae8c-7cd8-4d61-8e45-902f10c93678.mp4","videoBytes":262134,"duration":5.875},"4368213f65ce":{"text":"Yes, we watch together on weekends.","id":"4368213f65ce","source":"BTS 23 · #30"},"48751540d541":{"text":"It is a program about real events or people.","id":"48751540d541","source":"BTS 23 · #32"},"5560f7effd31":{"text":"Do people really watch soap operas?","id":"5560f7effd31","source":"BTS 23 · #83","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/2a4effd0-d1a8-48ac-9719-4721f74c69ec.webp","imageBytes":18098},"a864cb2d2998":{"text":"Do you like nature documentaries?","id":"a864cb2d2998","source":"BTS 23 · #33","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/7029e4ac-7465-42c5-918f-f9d22a1fa8c0.webp","imageBytes":57074},"1656effcacda":{"text":"Yes, they are very educational.","id":"1656effcacda","source":"BTS 23 · #34"},"e5ededbc5009":{"text":"What about sports on TV?","id":"e5ededbc5009","source":"BTS 23 · #35"},"8fea5f73f271":{"text":"I watch soccer matches and tennis tournaments.","id":"8fea5f73f271","source":"BTS 23 · #36","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/96e7b4f8-1dff-428e-961d-e197852b7f0c.webp","imageBytes":13676},"677f403fb07e":{"text":"What is a commercial break?","id":"677f403fb07e","source":"BTS 23 · #39"},"67ac9642b401":{"text":"It is when advertisements are shown.","id":"67ac9642b401","source":"BTS 23 · #40","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/3b910864-dd58-4411-b2cd-95966d88081b.webp","imageBytes":11758},"3daeb812d4b2":{"text":"How long is each episode?","id":"3daeb812d4b2","source":"BTS 23 · #79","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/c6c52ff9-e752-4201-9000-334197d7860f.webp","imageBytes":25266},"41e5ebcf0d95":{"text":"How long are commercial breaks?","id":"41e5ebcf0d95","source":"BTS 23 · #41"},"6cd036989f5e":{"text":"Usually about two to three minutes.","id":"6cd036989f5e","source":"BTS 23 · #42"},"58e6e922c2e1":{"text":"Yes, I fast forward when I can.","id":"58e6e922c2e1","source":"BTS 23 · #44","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/18e08a10-b0ab-4c63-b3c5-807e5a947487.webp","imageBytes":4852},"9b218ad0d64d":{"text":"It should be memorable and creative.","id":"9b218ad0d64d","source":"BTS 23 · #46"},"b414c857be41":{"text":"Do ads influence your purchases?","id":"b414c857be41","source":"BTS 23 · #47","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/89500c4f-fcb3-428a-9727-794fa4fe374d.webp","imageBytes":24706},"385356f5767b":{"text":"Sometimes, but I try to be careful.","id":"385356f5767b","source":"BTS 23 · #48"},"bbefd5268dc2":{"text":"What is a news broadcast?","id":"bbefd5268dc2","source":"BTS 23 · #49"},"0619b9ca35bd":{"text":"It is a program about current events.","id":"0619b9ca35bd","source":"BTS 23 · #50"},"fd44d9c42ed1":{"text":"Yes, I like to stay informed.","id":"fd44d9c42ed1","source":"BTS 23 · #54"},"a3bf71e5a5fe":{"text":"What kinds of news stories interest you?","id":"a3bf71e5a5fe","source":"BTS 23 · #55"},"9a5d6eced9e0":{"text":"What is a weather report?","id":"9a5d6eced9e0","source":"BTS 23 · #57"},"c4d6893cf863":{"text":"It tells you what the weather will be.","id":"c4d6893cf863","source":"BTS 23 · #58"},"ceba448a0ff5":{"text":"Is the weather forecast always accurate?","id":"ceba448a0ff5","source":"BTS 23 · #59"},"bdf5a2a0cae5":{"text":"No, sometimes it changes.","id":"bdf5a2a0cae5","source":"BTS 23 · #60"},"140400c19b18":{"text":"It is a program shown as it happens.","id":"140400c19b18","source":"BTS 23 · #62"},"351677cbc97e":{"text":"Yes, I watched the Olympics live.","id":"351677cbc97e","source":"BTS 23 · #64","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/deaca83b-d0a7-48e3-863f-12c0cad3bc0a.webp","imageBytes":17524},"52c71332bd15":{"text":"It is a long-running dramatic TV series.","id":"52c71332bd15","source":"BTS 23 · #82","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/51b8cd30-f621-4930-9eab-1af5abc97f13.webp","imageBytes":32136},"7a95e3e4b76d":{"text":"Do you watch series online?","id":"7a95e3e4b76d","source":"BTS 23 · #67"},"c66bd77e036a":{"text":"Yes, many services offer streaming.","id":"c66bd77e036a","source":"BTS 23 · #94","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/1cc8f76a-25e1-4357-901e-6bef15646ef5.webp","imageBytes":20416},"b9b749ea0dfb":{"text":"What is a reality TV show?","id":"b9b749ea0dfb","source":"BTS 23 · #69"},"4c8c0815f78f":{"text":"It shows real people in various situations.","id":"4c8c0815f78f","source":"BTS 23 · #70"},"ac81e6b8ea3b":{"text":"What is a talk show?","id":"ac81e6b8ea3b","source":"BTS 23 · #73"},"da821c2b0209":{"text":"The host interviews guests and talks about topics.","id":"da821c2b0209","source":"BTS 23 · #74","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/f23d30d8-91c3-412a-b9c8-8bb2a8350912.webp","imageBytes":16596},"876386abff81":{"text":"I like hosts who are funny and engaging.","id":"876386abff81","source":"BTS 23 · #76","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2o