1688":{"text":"What would you do if you could stop time?","id":"81a69c9d1688","source":"BTS 24 · #15"},"2024a1a0cce6":{"text":"I would use the extra time to study and play.","id":"2024a1a0cce6","source":"BTS 24 · #16"},"96699ace1541":{"text":"If dragons were real, would you be scared?","id":"96699ace1541","source":"BTS 24 · #17","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/583fda13-f3fe-42f1-a189-cd52b69b2c15.webp","imageBytes":27912},"6a24ac63a179":{"text":"No, I would try to make friends with one!","id":"6a24ac63a179","source":"BTS 24 · #18"},"716dd4ca8ee3":{"text":"Use your imagination to create something new.","id":"716dd4ca8ee3","source":"BTS 24 · #19"},"c4c4460d08eb":{"text":"Anything is possible if you believe in yourself.","id":"c4c4460d08eb","source":"BTS 24 · #20"},"f17273715489":{"text":"What if you could live in a castle?","id":"f17273715489","source":"BTS 24 · #21"},"18762a61374e":{"id":"18762a61374e","source":"BTS 15 · #7","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/9ed7dd2a-eb52-4a19-a978-d5cb7d2ec244.webp","imageBytes":20002,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/8f439290-128a-4cc5-be07-4105a45ddfcf.mp4","videoBytes":259424,"duration":5.875},"bd767238c6c1":{"text":"I would love to have a castle with a moat.","id":"bd767238c6c1","source":"BTS 24 · #22","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/cddf6beb-0d2f-4e90-b1ec-6c0c2dae1ce6.webp","imageBytes":27998},"452c07fbe76e":{"text":"If you had a magic wand, what would you do?","id":"452c07fbe76e","source":"BTS 24 · #23","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/94701301-51fe-472c-a4b2-e8381e398758.webp","imageBytes":11370},"4318ac7a1cfe":{"text":"I would make everyone happy.","id":"4318ac7a1cfe","source":"BTS 24 · #24"},"9766195728e1":{"text":"What if you could be any animal?","id":"9766195728e1","source":"BTS 24 · #25"},"3c30b63e2063":{"text":"I would be an eagle and fly high.","id":"3c30b63e2063","source":"BTS 24 · #26","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/dc6e5634-0fae-4368-ae8b-a16c7507bbd3.webp","imageBytes":8094},"fd8a312bc1b4":{"text":"If you discovered a magical forest, what would you explore?","id":"fd8a312bc1b4","source":"BTS 24 · #27"},"7540b8da2dc8":{"id":"7540b8da2dc8","source":"SIU Advance 3 · #43","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/32bc01d9-e144-41b0-bb90-d51ddbc427ef.webp","imageBytes":57818},"eb3a8c4a1ddc":{"text":"I would look for magical creatures.","id":"eb3a8c4a1ddc","source":"BTS 24 · #28","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/09cf7f29-2166-434c-8335-60744f4a40f9.webp","imageBytes":39378},"a4a33a4c4935":{"text":"What if you found a treasure map?","id":"a4a33a4c4935","source":"BTS 24 · #29","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/4ba35b37-ae1b-4fc6-ab40-922926bf20ae.webp","imageBytes":25636},"d05dbaa1f98d":{"text":"I would follow it to find buried treasure.","id":"d05dbaa1f98d","source":"BTS 24 · #30","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/6e5457db-a4c7-42e3-ad32-2c3aa14a8e9c.webp","imageBytes":49624},"226b1a12012f":{"text":"If you had a time machine, when would you go?","id":"226b1a12012f","source":"BTS 24 · #31"},"0ec1b3767c95":{"text":"I would visit ancient Egypt.","id":"0ec1b3767c95","source":"BTS 24 · #32","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/2324e6fe-b5bb-4658-870e-070fc7c62c17.webp","imageBytes":22562},"dddfd035d794":{"text":"What if you could have any pet?","id":"dddfd035d794","source":"BTS 24 · #33"},"8f4a1e5fec67":{"text":"I would have a unicorn or a phoenix.","id":"8f4a1e5fec67","source":"BTS 24 · #34","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/4a6af437-1375-4e84-b10d-691966d6a2b7.webp","imageBytes":21156},"88564bdca339":{"text":"If you could live in a fantasy world, which would you choose?","id":"88564bdca339","source":"BTS 24 · #35"},"832752d63bc8":{"text":"The Lord of the Rings world would be amazing.","id":"832752d63bc8","source":"BTS 24 · #36"},"c92f3863990f":{"text":"What if you were a wizard like Harry Potter?","id":"c92f3863990f","source":"BTS 24 · #37","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/702431c5-a7a6-4ad0-a53b-65585737acb7.webp","imageBytes":31096},"78373681a814":{"text":"I would learn all the magical spells.","id":"78373681a814","source":"BTS 24 · #38","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/2edcbf79-0f3a-45d4-a744-5573667e5e7a.webp","imageBytes":18750},"b5f937b8b7aa":{"text":"If you could have a superpower, what would it be?","id":"b5f937b8b7aa","source":"BTS 24 · #39","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/cccfff7a-b564-481e-9682-42d53581658c.webp","imageBytes":58252},"78670e1b8f90":{"text":"I would choose the power to heal anyone.","id":"78670e1b8f90","source":"BTS 24 · #40","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/5a1cf731-89ed-43d8-9468-53e5cf7031ad.webp","imageBytes":7332},"9aa8b9687fd0":{"text":"What if you could speak all languages?","id":"9aa8b9687fd0","source":"BTS 24 · #41"},"d9c5966a4198":{"text":"I could travel anywhere and understand everyone.","id":"d9c5966a4198","source":"BTS 24 · #42"},"b0f8e61f2cd5":{"text":"If you could see into the future, would you want to?","id":"b0f8e61f2cd5","source":"BTS 24 · #43"},"d2d482037424":{"text":"Maybe, but knowing too much might be bad.","id":"d2d482037424","source":"BTS 24 · #44","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/6542ab90-943c-4c28-8dbf-7e102cca7053.webp","imageBytes":27974},"b9be224d58bc":{"text":"What if you discovered you were royalty?","id":"b9be224d58bc","source":"BTS 24 · #45","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/1af75b04-43cc-444a-b01d-fff53c18cce5.webp","imageBytes":26254},"11cac3a443ad":{"text":"That would be shocking but exciting.","id":"11cac3a443ad","source":"BTS 24 · #46","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/ac6a3e02-74a7-4b4b-9f73-e7440720816c.webp","imageBytes":12656},"b6ba4fa7f01b":{"text":"If you could have any fantasy creature as a friend, who?","id":"b6ba4fa7f01b","source":"BTS 24 · #47","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/547315f6-df66-4f49-94da-ddad3ca83e83.webp","imageBytes":28554},"2228f5afe82e":{"id":"2228f5afe82e","source":"BTS 32 · #17","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/faf03b99-294e-4a70-b776-b112b39ed749.webp","imageBytes":22128,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/1bc88374-c728-4eee-ab2d-a2decfeb2c99.mp4","videoBytes":182068,"duration":5.875},"5b20c3d56d75":{"text":"I would have a dragon as my best friend.","id":"5b20c3d56d75","source":"BTS 24 · #48"},"ef94ac4221df":{"text":"What if you found a magical book?","id":"ef94ac4221df","source":"BTS 24 · #49"},"5d9f009a80d8":{"text":"I would read it immediately.","id":"5d9f009a80d8","source":"BTS 24 · #50","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/0c5bd5ba-8052-4a48-8003-802156042861.webp","imageBytes":13450},"496603ec7088":{"text":"It would have floating islands and crystal towers.","id":"496603ec7088","source":"BTS 24 · #52","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/32c2e8b2-02e7-408d-ad55-30e43358032e.webp","imageBytes":22980},"411f19a7de60":{"text":"What if you had infinite wishes?","id":"411f19a7de60","source":"BTS 24 · #53"},"8c64a46717fa":{"text":"I would wish for world peace.","id":"8c64a46717fa","source":"BTS 24 · #54"},"d3262baf2c02":{"text":"If you could be a character from a story, who would you be?","id":"d3262baf2c02","source":"BTS 24 · #55"},"eabcdbb4c2ac":{"text":"I would be Hermione Granger.","id":"eabcdbb4c2ac","source":"BTS 24 · #56","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/9458f096-9529-442a-a20c-26f3821788a7.webp","imageBytes":16374},"59e14f3f8729":{"text":"What if you could visit Hogwarts School?","id":"59e14f3f8729","source":"BTS 24 · #57","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/6c21fe6b-40af-4678-9f71-d8bfaf772004.webp","imageBytes":38128},"6c656168e1a5":{"id":"6c656168e1a5","source":"SIU Basic 3 · #43","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/e901ca1a-54ba-48a8-b5a3-0ce3adad9f9c.webp","imageBytes":18360,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/3f65bf67-41c1-49f8-8d2f-9fa3424dbc18.mp4","videoBytes":111852,"duration":5.875},"e0f554e28b27":{"text":"If you had a lightsaber, would you use it?","id":"e0f554e28b27","source":"BTS 24 · #59","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/29ee580f-c6fc-4b2b-b7f0-5fa176d47d1b.webp","imageBytes":4476},"cef7ccc623c4":{"text":"I would only use it for good purposes.","id":"cef7ccc623c4","source":"BTS 24 · #60"},"84f6f774c05f":{"text":"What if you were a superhero, what would be your name?","id":"84f6f774c05f","source":"BTS 24 · #61"},"9884447553e9":{"text":"I would be called Captain Justice.","id":"9884447553e9","source":"BTS 24 · #62"},"72fa41ccd036":{"text":"If you could have any magical item, what would it be?","id":"72fa41ccd036","source":"BTS 24 · #63"},"de7b0d1a2edf":{"text":"A cloak of invisibility would be useful.","id":"de7b0d1a2edf","source":"BTS 24 · #64","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/b5eb1f14-2bb4-4efe-b08a-bfccdc21ac07.webp","imageBytes":7422},"0a7d143a60ff":{"text":"What if you discovered a parallel universe?","id":"0a7d143a60ff","source":"BTS 24 · #65"},"c428bb084bfd":{"text":"I would explore it carefully.","id":"c428bb084bfd","source":"BTS 24 · #66"},"a3102430fc1e":{"text":"If you could rewrite any story, which would you choose?","id":"a3102430fc1e","source":"BTS 24 · #67"},"dba792ed33a8":{"text":"I would give it a happier ending.","id":"dba792ed33a8","source":"BTS 24 · #68","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/adf4ae82-cace-488b-a9b6-d02d7349bf3d.webp","imageBytes":15282},"48398fccd050":{"text":"What if you had genie granting three wishes?","id":"48398fccd050","source":"BTS 24 · #69"},"957e0121fc58":{"text":"I would wish for happiness for everyone.","id":"957e0121fc58","source":"BTS 24 · #70"},"d5dc8e251f80":{"text":"If you could live forever, would you want to?","id":"d5dc8e251f80","source":"BTS 24 · #71"},"9b8c02d2d3d9":{"text":"Maybe, if I could stay young.","id":"9b8c02d2d3d9","source":"BTS 24 · #72"},"10af7f5eb6a5":{"text":"What if you could be invisible for a day?","id":"10af7f5eb6a5","source":"BTS 24 · #73"},"c7d631171fa4":{"text":"I would explore places I cannot normally go.","id":"c7d631171fa4","source":"BTS 24 · #74","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/03735393-116a-408b-8f17-d3d15ae5e589.webp","imageBytes":26004},"d3f03e676271":{"text":"If you had a magic mirror, what would you ask it?","id":"d3f03e676271","source":"BTS 24 · #75"},"30cf4baf2425":{"text":"What if you could transform into anything?","id":"30cf4baf2425","source":"BTS 24 · #77"},"cf597991095d":{"text":"I would transform into a bird and fly.","id":"cf597991095d","source":"BTS 24 · #78","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/cb394544-594e-4662-ac5a-c920b91a4c16.webp","imageBytes":5304},"98bb52f3aa40":{"text":"If you discovered a secret passage, where would it lead?","id":"98bb52f3aa40","source":"BTS 24 · #79","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/a435cd3f-26b9-4a23-b818-274d258de30c.webp","imageBytes":35056},"8fc1c4fada1e":{"text":"It would lead to a hidden treasure room.","id":"8fc1c4fada1e","source":"BTS 24 · #80"},"b89bd6424075":{"text":"What if you were chosen as the chosen one?","id":"b89bd6424075","source":"BTS 24 · #81","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/20503abf-16f6-4de2-99a7-f705f6c7decf.webp","imageBytes":15674},"93579612ff11":{"text":"I would accept the responsibility.","id":"93579612ff11","source":"BTS 24 · #82"},"c7965ad0567d":{"text":"If you could travel to space, where would you go?","id":"c7965ad0567d","source":"BTS 24 · #83"},"89d949d66e84":{"text":"I would visit distant galaxies.","id":"89d949d66e84","source":"BTS 24 · #84"},"8f9acfb88953":{"text":"What if aliens came to Earth?","id":"8f9acfb88953","source":"BTS 24 · #85","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/8c3ad72e-e2f7-404b-b7d3-f912411f9e61.webp","imageBytes":23160},"aaf3d9f389e8":{"text":"I would try to communicate peacefully.","id":"aaf3d9f389e8","source":"BTS 24 · #86","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/5141b516-6300-405a-a489-33cf7b5d424c.webp","imageBytes":23774},"3923818b5067":{"text":"If you could build anything, what would it be?","id":"3923818b5067","source":"BTS 24 · #87"},"404de9b06df2":{"text":"I would build a theme park.","id":"404de9b06df2","source":"BTS 24 · #88","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/63040596-5c80-41b8-b2ea-003ac24ee934.webp","imageBytes":24774},"34ee1683fa0a":{"text":"What if you found a genie in a lamp?","id":"34ee1683fa0a","source":"BTS 24 · #89","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/30371f6e-4b10-43b0-b751-c294ad74a54b.webp","imageBytes":15316},"28bd4d8cdf84":{"text":"I would wish for wisdom.","id":"28bd4d8cdf84","source":"BTS 24 · #90","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/7efc2bc2-3f55-47ee-b8ba-43e182dbcfcf.webp","imageBytes":16348},"c2c5b663c94e":{"text":"If you could control the elements, which would you choose?","id":"c2c5b663c94e","source":"BTS 24 · #91"},"133317926c26":{"text":"I would control water and ice.","id":"133317926c26","source":"BTS 24 · #92"},"e866a01eba13":{"text":"What if you could live in any fictional place?","id":"e866a01eba13","source":"BTS 24 · #93"},"b5aa27c42b35":{"text":"I would choose Narnia.","id":"b5aa27c42b35","source":"BTS 24 · #94"},"062f09cd1e7b":{"text":"If you could have any magical ability, what would it be?","id":"062f09cd1e7b","source":"BTS 24 · #95"},"6c51c3424791":{"text":"Teleportation would be useful.","id":"6c51c3424791","source":"BTS 24 · #96","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/2b927789-1d03-4b97-8211-2c3b0cfdc694.webp","imageBytes":32622},"deecdf793157":{"text":"What if you were a dragon slayer?","id":"deecdf793157","source":"BTS 24 · #97","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/8d473e6b-a8b2-470e-82d5-390ed1fa7009.webp","imageBytes":34128},"3a057af54677":{"text":"I would be very brave and strong.","id":"3a057af54677","source":"BTS 24 · #98"},"53a3ab24773e":{"text":"If you could create a new fantasy world, describe it.","id":"53a3ab24773e","source":"BTS 24 · #99","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/873d0798-8b16-490e-b64e-cfc8277ccce2.webp","imageBytes":39534},"c641ffbac3a3":{"text":"It would have magic, adventure, and peace.","id":"c641ffbac3a3","source":"BTS 24 · #100","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/93ef6cf6-bd6b-43c4-9bea-673d6161dba1.webp","imageBytes":63538}}}
