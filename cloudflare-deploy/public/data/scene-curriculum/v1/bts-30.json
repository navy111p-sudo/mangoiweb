":"52e1ddf00310","source":"BTS 30 · #4"},"1f585c12bc7d":{"text":"It helps me get a good night's sleep.","id":"1f585c12bc7d","source":"BTS 30 · #5","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/26ae771a-88a0-44f5-9500-e58d52b48b85.webp","imageBytes":10760},"5d1e1f9f1a38":{"text":"Math is my best subject in school.","id":"5d1e1f9f1a38","source":"BTS 30 · #6","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/c7aefb0c-cd08-46e9-a3ae-e62b6b728c82.webp","imageBytes":13232},"6c656168e1a5":{"id":"6c656168e1a5","source":"SIU Basic 3 · #43","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/e901ca1a-54ba-48a8-b5a3-0ce3adad9f9c.webp","imageBytes":18360,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/3f65bf67-41c1-49f8-8d2f-9fa3424dbc18.mp4","videoBytes":111852,"duration":5.875},"723c330b9a61":{"text":"My teacher tells me that I have a natural talent for mathematics.","id":"723c330b9a61","source":"BTS 30 · #7"},"f391367c92ad":{"text":"I see numbers as a language, and I learn it very quickly.","id":"f391367c92ad","source":"BTS 30 · #8"},"26e7ff1e7f40":{"text":"I really enjoy learning about computers.","id":"26e7ff1e7f40","source":"BTS 30 · #9"},"4ea5a762e436":{"text":"I really hope I can use math in my career.","id":"4ea5a762e436","source":"BTS 30 · #10"},"4fa8d7db1d15":{"text":"I think I could be a scientist, an engineer, or a computer programmer.","id":"4fa8d7db1d15","source":"BTS 30 · #11"},"82baa41daf1f":{"id":"82baa41daf1f","source":"SIU Advance 1 · #76","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/ba88532e-a4e8-4def-aff5-d13a38b9badb.webp","imageBytes":17400},"dc8f45aea350":{"text":"Then I can have a satisfying career doing something I am really good at.","id":"dc8f45aea350","source":"BTS 30 · #12","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/f3bd8d55-a633-442d-b08b-db92c84ab5a1.webp","imageBytes":12366},"a8b24e525a1a":{"text":"What kind of training do you need for this job?","id":"a8b24e525a1a","source":"BTS 30 · #13"},"9d3687aabca4":{"text":"How many years do you have to go to school?","id":"9d3687aabca4","source":"BTS 30 · #14"},"7d54c1bb6c63":{"text":"What does the job involve?","id":"7d54c1bb6c63","source":"BTS 30 · #15","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/61899444-efe1-46f9-bf52-2526dd74b044.webp","imageBytes":34054},"f00ae3bc875c":{"text":"Have you ever thought about living in another country?","id":"f00ae3bc875c","source":"BTS 30 · #16"},"2dd17263ec39":{"text":"What would you miss most about Korea?","id":"2dd17263ec39","source":"BTS 30 · #17","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/8c8b5d57-2c24-4bfe-88f1-ba92c074ef7f.webp","imageBytes":24152},"fe7fce0d234b":{"id":"fe7fce0d234b","source":"SIU Basic 2 · #28","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/1d478d38-807e-4727-8e62-b03b99803489.webp","imageBytes":12944,"video":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/3d02ae8c-7cd8-4d61-8e45-902f10c93678.mp4","videoBytes":262134,"duration":5.875},"bfc7a7e745cf":{"text":"I would miss my family and Korean food.","id":"bfc7a7e745cf","source":"BTS 30 · #18"},"b43cda279f1e":{"text":"What career are you interested in?","id":"b43cda279f1e","source":"BTS 30 · #19"},"17a8bfae605a":{"text":"I am interested in becoming a doctor.","id":"17a8bfae605a","source":"BTS 30 · #20"},"46b05aaadc6a":{"text":"Living abroad is an exciting challenge.","id":"46b05aaadc6a","source":"BTS 30 · #21"},"57b43758753d":{"text":"Moving to another country requires planning.","id":"57b43758753d","source":"BTS 30 · #22"},"fe663c2df451":{"text":"You need a passport to travel internationally.","id":"fe663c2df451","source":"BTS 30 · #23"},"e631c8cb3d0d":{"text":"Immigration laws vary by country.","id":"e631c8cb3d0d","source":"BTS 30 · #24","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/7b3f6932-4de9-40a6-95af-dfc43474e605.webp","imageBytes":15522},"96d86281c2ae":{"text":"Visas allow people to stay in a foreign country.","id":"96d86281c2ae","source":"BTS 30 · #25"},"fc95f867023c":{"text":"Work visas let you get a job in another country.","id":"fc95f867023c","source":"BTS 30 · #26"},"1a1ee25ae6ef":{"text":"Student visas allow people to study abroad.","id":"1a1ee25ae6ef","source":"BTS 30 · #27"},"d0077ef0a537":{"text":"Learning the local language helps you adapt.","id":"d0077ef0a537","source":"BTS 30 · #28"},"0bf1a23404f9":{"text":"New languages are challenging but rewarding.","id":"0bf1a23404f9","source":"BTS 30 · #29"},"66f05b0b32c1":{"text":"Making friends in a new country helps you adjust.","id":"66f05b0b32c1","source":"BTS 30 · #30","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/c88bb867-9894-494a-8f95-b07d3c2e046c.webp","imageBytes":20282},"2bc907e79ab8":{"text":"Homesickness is common when living abroad.","id":"2bc907e79ab8","source":"BTS 30 · #31","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/7ee97364-cc6c-40ec-b8a4-8d671947ac1c.webp","imageBytes":35084},"c14e36309d7a":{"text":"Staying in touch with family back home is important.","id":"c14e36309d7a","source":"BTS 30 · #32","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/875521e2-f159-4ae7-8190-5f63446ac2d0.webp","imageBytes":23768},"7854d6e0cdc4":{"text":"Video calls let you speak with people far away.","id":"7854d6e0cdc4","source":"BTS 30 · #33","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/5d52124e-6fac-49e4-a703-af0497a59174.webp","imageBytes":10368},"5c21609e5e78":{"text":"Cultural differences can be interesting to experience.","id":"5c21609e5e78","source":"BTS 30 · #34"},"1ba27e099278":{"text":"Trying new foods is part of adapting to a new culture.","id":"1ba27e099278","source":"BTS 30 · #35","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/8f7a4aa8-904c-405f-835a-dc6eff580dcc.webp","imageBytes":26832},"acf3709a2637":{"text":"Different countries have different customs and traditions.","id":"acf3709a2637","source":"BTS 30 · #36"},"7975f95ca1b3":{"text":"Respect for local customs is important.","id":"7975f95ca1b3","source":"BTS 30 · #37"},"0a4f5480c768":{"text":"Dating and relationships can cross cultural boundaries.","id":"0a4f5480c768","source":"BTS 30 · #38","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/7a5baf4f-9507-4b1b-9df2-062c63e3a9ca.webp","imageBytes":18128},"f8c9b29a25ae":{"text":"International marriages are becoming more common.","id":"f8c9b29a25ae","source":"BTS 30 · #39","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/b695c29b-3f09-4bd5-b516-c37a13193281.webp","imageBytes":16192},"cf93a74c2f97":{"text":"Raising children in a foreign country is a big responsibility.","id":"cf93a74c2f97","source":"BTS 30 · #40"},"22e4a67b3deb":{"text":"Bilingual children are fortunate to speak multiple languages.","id":"22e4a67b3deb","source":"BTS 30 · #41","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/a2318563-faaf-4833-a256-2b8c8e91a31c.webp","imageBytes":21242},"12aa0cc0b789":{"id":"12aa0cc0b789","source":"SIU Advance 1 · #63","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/b02393ea-2be5-4d62-aba7-e1379c94f0e0.webp","imageBytes":26028},"0e0e159801d7":{"text":"Healthcare systems differ between countries.","id":"0e0e159801d7","source":"BTS 30 · #42","image":"https://d2ol7oe51mr4n9.cloudfront.net/user_3GD1yS6zlj6afu2oFQqivYqvn7k/112a93a2-7e47-4e63-8848-3c801bcb4e9b.webp","imageBytes":14938},"ffe57ac7dd32":{"text":"Finding quality healthcare abroad is important.","id":"ffe57ac7dd32","source":"BTS 30 · #43"},"d28fc5113633":{"text":"Cost of living varies greatly by country.","id":"d2