          "scored": true,
          "start": 27.237708333333334,
          "end": 29.187708333333333
        },
        {
          "id": "s2-l9",
          "speaker": "pip",
          "en": "The light is getting weaker.",
          "ko": "빛이 점점 약해지고 있어.",
          "emotion": "concerned",
          "scored": true,
          "start": 31.42025,
          "end": 33.48525
        },
        {
          "id": "s2-l10",
          "speaker": "maya",
          "en": "Then we must work together.",
          "ko": "그럼 우리가 힘을 합쳐야 해.",
          "emotion": "determined",
          "scored": true,
          "start": 34.517354166666664,
          "end": 37.017354166666664
        }
      ]
    },
