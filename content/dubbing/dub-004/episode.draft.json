          "scored": true,
          "start": 8.1963125,
          "end": 9.7313125
        },
        {
          "id": "s2-l4",
          "speaker": "pip",
          "en": "Wait! Let us ask first.",
          "ko": "잠깐! 먼저 물어보자.",
