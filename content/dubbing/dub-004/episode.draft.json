          "scored": true,
          "start": 30.018208333333334,
          "end": 31.813208333333332
        },
        {
          "id": "s1-l9",
          "speaker": "pip",
          "en": "I can hear something ringing.",
          "ko": "뭔가 울리는 소리가 들려.",
