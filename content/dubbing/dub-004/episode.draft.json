          "scored": true,
          "start": 24.225604166666667,
          "end": 26.205604166666667
        },
        {
          "id": "s2-l8",
          "speaker": "kai",
          "en": "I think I misunderstood you.",
          "ko": "내가 모모를 오해한 것 같아.",
