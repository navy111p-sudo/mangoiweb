          "scored": true,
          "start": 14.9874375,
          "end": 17.4374375
        },
        {
          "id": "s1-l5",
          "speaker": "momo",
          "en": "Welcome aboard, my brave friends!",
          "ko": "용감한 친구들, 승선을 환영해!",
