<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ko</string>
	<key>CFBundleDisplayName</key>
	<string>망고아이</string>
	<key>CFBundleName</key>
	<string>Mangoi</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- ── 권한 사용 이유(한국어) — 비어 있으면 앱이 그 자리에서 강제종료된다 ── -->
	<key>NSCameraUsageDescription</key>
	<string>화상수업에서 선생님과 얼굴을 보며 대화하기 위해 카메라를 사용합니다.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>화상수업과 말하기 연습에서 목소리를 전달하기 위해 마이크를 사용합니다.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>숙제 사진이나 파일을 선생님께 제출할 때 사진을 선택하기 위해 사용합니다.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>수업 자료나 성적표 이미지를 사진 앱에 저장할 때 사용합니다.</string>

	<!-- ── 카카오톡 상담 딥링크 ──
	     이 목록에 스킴을 적어두지 않으면 canOpenURL 이 항상 false 를 돌려줘
	     카카오톡이 깔려 있어도 "설치하세요" 화면으로 떨어진다. (안드로이드에서 겪은 그 문제) -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>kakaoplus</string>
		<string>kakaotalk</string>
		<string>kakaolink</string>
	</array>

	<!-- ── 백그라운드 오디오 ──
	     화상수업 중 사용자가 홈으로 나가거나 화면이 꺼져도 소리가 끊기지 않게 한다.
	     ⚠️ 심사 때 애플이 "왜 필요한가"를 물을 수 있음 → 실시간 화상수업이라고 답변 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- 가로/세로 모두 지원 (화상수업은 가로, 학습 화면은 세로 사용) -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- 런치스크린: 별도 스토리보드 파일 없이 배경색만 (사이트 배경 #050714 와 맞춤) -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>

	<!-- 상태바를 앱이 직접 관리(웹 화면이 노치까지 채우므로) -->
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- 제출할 때마다 묻는 수출규제 질문을 미리 답해 둔다 (표준 https 만 사용) -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
